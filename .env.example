# BloodChain environment template.
#
# Copy to `.env` (repo root, used by docker compose) and to `apps/api/.env`
# (used when running the API directly). Every value below is safe for local
# development only.
#
# An empty value means "not configured" and is accepted — the API validates
# this file's shape at boot (apps/api/src/config/env.validation.ts), and a
# test keeps the two in sync.

NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/donor"

# Access tokens are JWTs. Refresh tokens are opaque random strings, and their
# lifetime is NOT set here — it comes from the platform's own
# `sessionTimeoutMinutes` setting, editable by a SUPER_ADMIN in the admin app.
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret-min-32-chars"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"

API_URL="http://localhost:3001"
# Comma-separated CORS allow-list: hospital, blood-center, admin web apps.
WEB_URL="http://localhost:3000,http://localhost:3002,http://localhost:3003"

# Where a password reset link points, per kind of account. Optional: each falls
# back to the first WEB_URL entry, which is all a single-origin deployment
# needs. Set them when the consoles live on different hosts, so a blood centre
# user is not mailed a link to the hospital console.
WEB_URL_HOSPITAL="http://localhost:3000"
WEB_URL_BLOOD_CENTER="http://localhost:3002"
WEB_URL_ADMIN="http://localhost:3003"
# Must match `expo.scheme` in apps/mobile/app.json.
MOBILE_DEEP_LINK="donor://"
THROTTLER_TTL=60
THROTTLER_LIMIT=100
# Sign-ins allowed per minute per IP. Raise it when several clients share one
# address -- a demo laptop running the phone, the emulator and three consoles.
AUTH_THROTTLE_LIMIT=5

# Outgoing email (registration verification, password reset). Leave SMTP_HOST
# empty in local dev — emails are logged to the console instead of being sent.
#
# To read a password reset link during development, run a local mail catcher
# and point these two at it. Never credentials, never a real host:
#
#   pnpm mail:dev                                  # prints messages and links
#   docker compose --profile dev up -d mailpit     # inbox at localhost:8025
#   SMTP_HOST="127.0.0.1"  SMTP_PORT=1025
#
# `pnpm demo:start` does this for you when a catcher is already listening.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="BloodChain <no-reply@donor.local>"
EMAIL_VERIFICATION_TTL_HOURS=24

# How long a password-reset link stays valid, in minutes. Single-use either way.
PASSWORD_RESET_TTL_MINUTES=60
# Minimum gap between reset emails for one account, in seconds.
PASSWORD_RESET_COOLDOWN_SECONDS=60

# --- SMS and one-time codes (phone-first donor sign-in) ----------------------
#
# Which adapter delivers an SMS. `console` prints the message to the API's own
# log instead of sending it, so phone sign-up can be built and demoed with no
# vendor account. The API REFUSES TO START with `console` when
# NODE_ENV=production: a one-time code sitting in a log file is an
# authentication bypass, not a degraded mode.
#
# No Uzbekistan SMS provider is configured yet. Before deployment, an adapter
# for the chosen aggregator (Eskiz, Play Mobile, SMS.uz or similar) goes in
# apps/api/src/modules/sms/providers/, is registered in sms.module.ts, and
# SMS_PROVIDER is set to its name. Nothing in the auth domain changes.
# Per-IP ceilings on the SMS endpoints, per fifteen minutes. Raise them behind
# a shared address -- a demo laptop, an office NAT, an end-to-end test run --
# where the default limits the building rather than a person.
OTP_THROTTLE_LIMIT=3
OTP_VERIFY_THROTTLE_LIMIT=10

SMS_PROVIDER=console
# Where the console adapter also appends each message as JSON, so scripts can
# read codes back without scraping stdout. Local convenience only; leave unset
# anywhere that is not a developer's machine.
SMS_DEV_LOG_FILE=

# A six-digit code is a million guesses, which is not many. These four numbers
# are what make that enough: a short life, few attempts per code, a floor
# between sends, and a ceiling per number per hour.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5

# Keys the HMAC that one-time codes are stored under. Optional: falls back to
# JWT_REFRESH_SECRET, which is already required and already secret. Set it
# separately if code hashes and refresh tokens should not share a key.
OTP_HASH_SECRET=
# Signs the short-lived ticket that proves a phone number was verified, between
# "code accepted" and "account created". Deliberately never JWT_ACCESS_SECRET:
# this token must not be something the bearer-token path would even attempt to
# parse. Falls back to JWT_REFRESH_SECRET.
PHONE_TICKET_SECRET=

# How long emergency journey location history is kept after the response
# closes, in hours. Location for an ACTIVE journey is never pruned regardless
# of this value.
#
# 72 hours is a development default chosen so the data outlives a debugging
# session -- it is NOT a legal retention period. The lawful retention limit for
# location data on identifiable citizens has to be set by counsel before any
# real deployment, and this variable exists so that decision is a
# configuration change rather than a code change.
EMERGENCY_LOCATION_RETENTION_HOURS=72

DONATION_COOLDOWN_DAYS=56

# Push notifications go through Expo's push service. The access token is
# optional — it is only needed for Expo's enhanced security / higher rate
# limits. There is no direct FCM or APNs integration in this codebase.
EXPO_ACCESS_TOKEN=""

# AI health insights. Disabled unless AI_ENABLED is exactly "true" AND a
# SUPER_ADMIN has the `aiHealthInsightsEnabled` platform setting on — both
# gates must pass. AI_API_KEY is required once enabled.
AI_ENABLED="false"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_BASE_URL="https://api.openai.com/v1"
AI_MAX_TOKENS=1000
AI_TIMEOUT_MS=30000

# Read by the frontends, not the API. The three Next.js apps fall back to
# http://localhost:3001, so these only matter once the API is not on localhost.
NEXT_PUBLIC_API_URL="http://localhost:3001"
EXPO_PUBLIC_API_URL="http://localhost:3001"
