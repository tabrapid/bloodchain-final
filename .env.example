# BloodChain environment template.
#
# Copy to `.env` (repo root, used by docker compose) and to `apps/api/.env`
# (used when running the API directly). Every value below is safe for local
# development only.
#
# An empty value means "not configured" and is accepted — the API validates
# this file's shape at boot (apps/api/src/config/env.validation.ts), and a
# test keeps the two in sync.

NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/donor"

# Access tokens are JWTs. Refresh tokens are opaque random strings, and their
# lifetime is NOT set here — it comes from the platform's own
# `sessionTimeoutMinutes` setting, editable by a SUPER_ADMIN in the admin app.
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret-min-32-chars"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"

API_URL="http://localhost:3001"
# Comma-separated CORS allow-list: hospital, blood-center, admin web apps.
WEB_URL="http://localhost:3000,http://localhost:3002,http://localhost:3003"
# Must match `expo.scheme` in apps/mobile/app.json.
MOBILE_DEEP_LINK="donor://"
THROTTLER_TTL=60
THROTTLER_LIMIT=100
# Sign-ins allowed per minute per IP. Raise it when several clients share one
# address -- a demo laptop running the phone, the emulator and three consoles.
AUTH_THROTTLE_LIMIT=5

# Outgoing email (registration verification, etc). Leave SMTP_HOST empty in
# local dev — emails are logged to the console instead of being sent.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="BloodChain <no-reply@donor.local>"
EMAIL_VERIFICATION_TTL_HOURS=24

DONATION_COOLDOWN_DAYS=56

# Push notifications go through Expo's push service. The access token is
# optional — it is only needed for Expo's enhanced security / higher rate
# limits. There is no direct FCM or APNs integration in this codebase.
EXPO_ACCESS_TOKEN=""

# AI health insights. Disabled unless AI_ENABLED is exactly "true" AND a
# SUPER_ADMIN has the `aiHealthInsightsEnabled` platform setting on — both
# gates must pass. AI_API_KEY is required once enabled.
AI_ENABLED="false"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_BASE_URL="https://api.openai.com/v1"
AI_MAX_TOKENS=1000
AI_TIMEOUT_MS=30000

# Read by the frontends, not the API. The three Next.js apps fall back to
# http://localhost:3001, so these only matter once the API is not on localhost.
NEXT_PUBLIC_API_URL="http://localhost:3001"
EXPO_PUBLIC_API_URL="http://localhost:3001"
