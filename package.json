{
  "name": "donor-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "pnpm --filter @donor/api dev",
    "dev:mobile": "pnpm --filter @donor/mobile start",
    "dev:hospital": "pnpm --filter @donor/hospital-web dev",
    "dev:blood-center": "pnpm --filter @donor/blood-center-web dev",
    "dev:admin": "pnpm --filter @donor/admin-web dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @donor/api prisma:generate",
    "db:migrate": "pnpm --filter @donor/api prisma:migrate",
    "db:seed": "pnpm --filter @donor/api prisma:seed",
    "db:reset": "pnpm --filter @donor/api prisma:reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
