{
  "name": "bloodchain",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "pnpm --filter @bloodchain/api dev",
    "dev:mobile": "pnpm --filter @bloodchain/mobile start",
    "dev:hospital": "pnpm --filter @bloodchain/hospital-web dev",
    "dev:blood-center": "pnpm --filter @bloodchain/blood-center-web dev",
    "dev:admin": "pnpm --filter @bloodchain/admin-web dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "pnpm --filter @bloodchain/api test:e2e",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:e2e",
    "db:generate": "pnpm --filter @bloodchain/api prisma:generate",
    "db:migrate": "pnpm --filter @bloodchain/api prisma:migrate",
    "db:seed": "pnpm --filter @bloodchain/api prisma:seed",
    "db:seed:reference": "pnpm --filter @bloodchain/api prisma:seed:reference",
    "db:reset": "pnpm --filter @bloodchain/api prisma:reset",
    "demo:reset": "node scripts/demo-reset.mjs",
    "demo:check": "node scripts/demo-check.mjs",
    "demo:start": "node scripts/demo-start.mjs",
    "test:scripts": "node --test scripts/*.spec.mjs",
    "demo:verify": "node scripts/demo-verify.mjs",
    "verify:safety": "node scripts/sprint0-verify.mjs",
    "mail:dev": "node scripts/dev-mail.mjs",
    "verify:recovery": "node scripts/recovery-verify.mjs",
    "verify:phone": "node scripts/phone-auth-verify.mjs",
    "verify:geography": "node scripts/verify-geography.mjs",
    "verify:booleans": "node scripts/verify-boolean-safety.mjs",
    "verify:e2e-isolation": "node scripts/verify-e2e-isolation.mjs",
    "verify:backup": "node scripts/verify-backup.mjs",
    "verify:migrations": "node scripts/verify-migration-upgrade.mjs",
    "clinical:review": "node scripts/clinical-review.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
