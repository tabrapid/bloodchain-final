model Appointment {
  id                 String            @id @default(cuid())
  referenceNumber    String            @unique
  donorId            String
  organizationId     String
  slotId             String
  appointmentType    AppointmentType
  /**
   * The laboratory test the donor booked, for BLOOD_TEST appointments.
   * Not a duplicate of LaboratoryResult.testTypeId: this records what was
   * *booked*, that records what was *performed*, and they can legitimately
   * differ if staff run a different panel. Without it the booked test was lost
   * between the donor's screen and the laboratory's, so staff had to re-pick it
   * from a list at result entry -- guessing, for a choice the donor had already
   * made.
   * Nullable because the generic POST /appointments path (used by the mobile
   * booking wizard) creates BLOOD_TEST appointments without one.
   */
  testTypeId         String?
  status             AppointmentStatus @default(PENDING)
  scheduledStart     DateTime
  scheduledEnd       DateTime
  notes              String?
  cancellationReason String?
  cancelledAt        DateTime?
  completedAt        DateTime?
  /**
   * When the "your appointment is coming up" reminder was sent for this
   * appointment, or null while it has not been.
   * This is what makes the reminder job idempotent. The job claims an
   * appointment by setting this column in a conditional update, so a restart
   * mid-run, two workers, or a cron that fires twice in the same window all
   * end with exactly one reminder: the second claim updates zero rows and
   * emits nothing. Nullable and defaulted-by-absence, so every appointment
   * that existed before this column simply has no reminder recorded.
   */
  reminderSentAt     DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  donor            User                 @relation(fields: [donorId], references: [id], onDelete: Cascade)
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slot             AppointmentSlot      @relation(fields: [slotId], references: [id], onDelete: Cascade)
  history          AppointmentHistory[]
  donation         Donation?
  laboratoryResult LaboratoryResult?
  testType         TestType?            @relation(fields: [testTypeId], references: [id], onDelete: SetNull)

  @@index([donorId])
  @@index([organizationId])
  @@index([slotId])
  @@index([status])
  @@index([scheduledStart])
  @@index([scheduledEnd])
  @@index([referenceNumber])
  @@index([donorId, status])
  // The reminder job's own query: upcoming appointments not yet reminded.
  @@index([status, scheduledStart, reminderSentAt])
}

