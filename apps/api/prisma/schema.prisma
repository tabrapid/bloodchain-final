/// The purposes personal data is processed for. A vocabulary, not a legal
/// determination: which of these a deployment may lawfully require is
/// `ConsentRequirement.mode`, set per deployment, and pending legal validation
/// (LP-01 .. LP-09).
///
/// `SERVICE_NOTIFICATIONS` and `MARKETING_COMMUNICATIONS` are separate members
/// on purpose. A transactional notice -- your appointment is tomorrow, your
/// result is ready -- is not marketing, and a consent model that cannot tell
/// them apart either spams people who refused marketing or silences the
/// service messages they are entitled to.
enum ConsentPurpose {
  CORE_ACCOUNT
  HEALTH_DONATION_DATA
  HEALTHCARE_SHARING
  EMERGENCY_MATCHING
  EMERGENCY_LIVE_LOCATION
  SERVICE_NOTIFICATIONS
  MARKETING_COMMUNICATIONS
  CROSS_BORDER_PROCESSING
}

enum ConsentDocumentStatus {
  DRAFT
  APPROVED
  RETIRED
}

/// How strongly a deployment requires a purpose. Configuration, not law.
