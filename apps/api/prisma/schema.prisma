/// A donor deferral, kept as history.
///
/// Before this model there were two half-answers: `AssessmentDecision.DEFERRED`
/// on a single donation, which expressed no period and reached nothing outside
/// that donation, and `DonorProfile.donorStatus = DEFERRED`, a flag with no
/// reason, no actor, no date and no history (DEF-01 .. DEF-05 in
/// docs/clinical-safety-gaps.md). Emergency matching read the flag; booking
/// read neither. Deferring a donor at the chair did not stop them booking
/// tomorrow.
///
/// Rows are never deleted and never rewritten in place. Lifting a deferral
/// sets `liftedAt`/`liftedBy`/`liftReason`; it does not remove the row, so
/// "was this donor ever deferred, and why" stays answerable.
///
/// NO CLINICAL DEFERRAL REASONS ARE DEFINED HERE. `reasonCode` points at a
/// vocabulary that ships empty, on purpose: no signed deferral schedule exists
/// (docs/review-packs/clinical-review.md, question CR-04).
model DonorDeferral {
  id               String         @id @default(cuid())
  donorId          String
  /// The organization whose staff raised it. Null for deferrals reconstructed
  /// by migration, which have no recorded origin.
  organizationId   String?
  kind             DeferralKind
  /// Configurable vocabulary. Ships empty; free text lives in `reasonText`.
  reasonCode       String?        @db.VarChar(80)
  reasonText       String?
  startsAt         DateTime       @default(now())
  /// Null for INDEFINITE. A TEMPORARY deferral without an end date would be an
  /// indefinite one wearing the wrong label, so the service refuses it.
  endsAt           DateTime?
  source           DeferralSource
  sourceDonationId String?
  createdBy        String?
  liftedAt         DateTime?
  liftedBy         String?
  liftReason       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  donor          User          @relation("DonorDeferralDonor", fields: [donorId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  creator        User?         @relation("DonorDeferralCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  lifter         User?         @relation("DonorDeferralLifter", fields: [liftedBy], references: [id], onDelete: SetNull)
  sourceDonation Donation?     @relation(fields: [sourceDonationId], references: [id], onDelete: SetNull)

  @@index([donorId])
  /// The shape `isDeferredAt` queries: this donor, not yet lifted.
  @@index([donorId, liftedAt])
  @@index([startsAt])
  @@index([endsAt])
  @@index([organizationId])
}

/// The boundary between this software and a clinical decision it is not
/// entitled to make.
///
/// Nothing in this repository knows which transfusion-transmissible infections
/// must be screened for, at what outcome, or how long a component keeps. Until
/// a clinician records that here as an APPROVED PRODUCTION policy, a unit
/// cannot become transfusable stock: `ClinicalReleaseService` answers
/// `CLINICAL_RELEASE_POLICY_NOT_CONFIGURED` and the unit stays where it is.
///
/// An APPROVED policy with no requirements is NOT an approval to release
/// everything. An empty requirement set is read as "nobody has said what must
/// be tested", which is exactly the state that has to fail closed.
///
/// THIS REPOSITORY SHIPS NO PRODUCTION POLICY AND NO REQUIREMENTS. Both are
/// data, entered by the people entitled to enter them.
model ClinicalReleasePolicy {
  id                       String                      @id @default(cuid())
  /// Null for a platform-wide policy. An organization-scoped policy wins over
  /// a platform-wide one for that organization.
  organizationId           String?
  /// `organizationId` or the literal "PLATFORM". Exists because Postgres treats
  /// NULLs as distinct in a unique index, so `@@unique([organizationId, version])`
  /// would happily accept two platform-wide version 1 policies.
  scopeKey                 String
  version                  Int
  status                   ClinicalReleasePolicyStatus @default(DRAFT)
  kind                     ClinicalReleasePolicyKind
  title                    String                      @db.VarChar(200)
  /// Where the rules came from: a standard, a protocol, a signed document.
  sourceReference          String?
  approvedBy               String?
  approvedAt               DateTime?
  effectiveFrom            DateTime?
  effectiveUntil           DateTime?
  /// Shelf life in days, for DEVELOPMENT_ONLY policies only.
  ///
  /// NOT a clinical shelf life and not usable as one: the service refuses to
  /// read it from a PRODUCTION policy, and any expiry derived from it is
  /// stamped `ExpiryProvenance.DEVELOPMENT_POLICY` so it can never be mistaken
  /// for a component shelf life somebody signed.
  developmentShelfLifeDays Int?
  createdBy                String?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  organization Organization?                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  approver     User?                        @relation("ClinicalReleasePolicyApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  creator      User?                        @relation("ClinicalReleasePolicyCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  requirements ClinicalReleaseRequirement[]
  decisions    ReleaseDecision[]

  @@unique([scopeKey, version])
  @@index([organizationId])
  @@index([status])
  @@index([kind])
}

/// One thing that must be satisfied before a unit may be released.
///
/// Configuration, not code. The repository ships none, and inventing any here
/// -- a TTI panel, an outcome, a threshold -- is precisely what Sprint 7
/// forbids. What the shape guarantees is that whatever a clinician eventually
/// writes down is evaluated per unit and recorded against the decision.
model ClinicalReleaseRequirement {
  id            String         @id @default(cuid())
  policyId      String
  /// Stable identifier used in refusal payloads and decision records.
  code          String         @db.VarChar(80)
  description   String
  /// Null means the requirement applies to every component type.
  componentType ComponentType?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  policy ClinicalReleasePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, code])
  @@index([policyId])
}

/// The record of a release evaluation -- both outcomes.
///
/// A refusal is recorded as well as a release, because "the system would not
/// let us release this unit, at this time, for this reason" is exactly the
/// question an incident review asks, and an unrecorded refusal is
/// indistinguishable from nobody having tried.
///
/// `policyVersion` and `policyKind` are copied onto the row rather than read
/// through the relation: the decision must still be readable as the decision
/// that was actually made, after the policy is superseded or retired.
model ReleaseDecision {
  id                String                     @id @default(cuid())
  bloodUnitId       String
  organizationId    String
  policyId          String?
  policyVersion     Int?
  policyKind        ClinicalReleasePolicyKind?
  outcome           ReleaseDecisionOutcome
  /// Machine-readable. `CLINICAL_RELEASE_POLICY_NOT_CONFIGURED` and friends.
  reasonCode        String                     @db.VarChar(80)
  /// Requirement codes that were not satisfied, when that is why it refused.
  unmetRequirements String[]
  decidedBy         String?
  decidedAt         DateTime                   @default(now())

  bloodUnit    BloodUnit              @relation(fields: [bloodUnitId], references: [id], onDelete: Cascade)
  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policy       ClinicalReleasePolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  decider      User?                  @relation("ReleaseDecisionDecider", fields: [decidedBy], references: [id], onDelete: SetNull)

  @@index([bloodUnitId])
  @@index([organizationId])
  @@index([outcome])
  @@index([decidedAt])
}

/// What finally happened to a unit, as one row at the end of its chain.
///
/// `recipientReference` is deliberately an opaque string with no identity
/// semantics. What identifies a transfusion recipient in this jurisdiction is
/// an unresolved legal and clinical question (CL-03, PR-02), and guessing at it
/// -- a national ID, a passport number, a name -- would write an invented
/// identity policy into the schema. The column exists so the eventual answer is
/// a configuration and UI change rather than a migration; until then it stays
/// null and the traceability chain says so.
model BloodUnitDisposition {
  id                 String          @id @default(cuid())
  bloodUnitId        String          @unique
  organizationId     String
  type               DispositionType
  occurredAt         DateTime        @default(now())
  recordedBy         String?
  /// Opaque, and scoped to `organizationId`. No identity policy is attached to
  /// this field. See the model note.
  ///
  /// "Organization-scoped" is load-bearing: the same string from two hospitals
  /// is two different people, and nothing in this schema or its indexes treats
  /// it as a global identifier. A blood centre reading a unit's chain sees that
  /// a disposition exists; resolving the reference to a person is the receiving
  /// organization's business and requires their own records.
  recipientReference String?         @db.VarChar(120)
  /// The episode of care, where the receiving organization records one. Also
  /// opaque, also organization-scoped, also optional -- an encounter identifier
  /// is not something this project may require (CL-03, PR-02).
  encounterReference String?         @db.VarChar(120)
  bloodRequestId     String?
  shipmentId         String?
  /// Free-text context for the disposition. For REACTION_REPORTED this is
  /// where the report goes: no reaction classification is encoded, because none
  /// has been validated (CR-08).
  context            String?
  notes              String?
  createdAt          DateTime        @default(now())

  bloodUnit    BloodUnit     @relation(fields: [bloodUnitId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recorder     User?         @relation("BloodUnitDispositionRecorder", fields: [recordedBy], references: [id], onDelete: SetNull)
  bloodRequest BloodRequest? @relation(fields: [bloodRequestId], references: [id], onDelete: SetNull)
  shipment     Shipment?     @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([type])
  @@index([occurredAt])
  @@index([organizationId, recipientReference])
}

/// A sample taken at collection, kept as its own identity.
///
/// A sample is not a component: it is the tube that goes to the laboratory,
/// and it must be traceable back to the same donation the components came
/// from. `sampleType` is a code from a vocabulary that SHIPS EMPTY -- which
/// tubes are drawn, and what is done with each, is a laboratory reviewer's
/// answer (LR-05) and not something this schema will invent.
model DonationSample {
  id              String   @id @default(cuid())
  /// Human-readable and barcode-ready, derived from the parent donation's
  /// identifier so the relationship survives being printed on a label.
  sampleReference String   @unique
  donationId      String
  organizationId  String
  sampleType      String?  @db.VarChar(80)
  collectedAt     DateTime @default(now())
  collectedBy     String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  donation     Donation     @relation(fields: [donationId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  collector    User?        @relation("DonationSampleCollector", fields: [collectedBy], references: [id], onDelete: SetNull)

  @@index([donationId])
  @@index([organizationId])
  @@index([sampleReference])
}

/// A storage requirement, as a reference a component can point at.
///
/// SHIPS EMPTY, and has no numeric fields on purpose. The temperatures a
/// component must be held at are clinical and regulatory values this project
/// does not have (CR-06, OR-05). `requirementText` exists so a reviewer's
/// signed answer has somewhere to live without this repository guessing at it
/// first. Versioned and approved on the `ClinicalReleasePolicy` pattern, so a
/// component's storage requirement stays readable after the policy moves on.
model StoragePolicy {
  id              String                @id @default(cuid())
  organizationId  String?
  /// `organizationId`, or the literal 'PLATFORM'. Exists because Postgres
  /// treats NULLs as distinct in a unique index, so a nullable column cannot
  /// carry the uniqueness this needs. Same reason as ClinicalReleasePolicy.
  scopeKey        String
  code            String                @db.VarChar(80)
  version         Int
  status          ConsentDocumentStatus @default(DRAFT)
  /// The reviewer's own words. No temperature is parsed out of it.
  requirementText String?
  sourceReference String?
  approvedBy      String?
  approvedAt      DateTime?
  effectiveFrom   DateTime?
  effectiveUntil  DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  approver     User?         @relation("StoragePolicyApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  units        BloodUnit[]

  @@unique([scopeKey, code, version])
  @@index([organizationId])
  @@index([status])
}

/// A restriction on a unit that is not a lifecycle state.
///
/// The unit keeps whatever status it had. This row is what refuses release,
/// reservation and issue while it is ACTIVE, and resolving it does exactly
/// one thing: it marks the hold resolved. It does NOT set `clinicalReleasedAt`,
/// does NOT change `status`, and does NOT touch `expiresAt` -- so lifting a
/// hold can never be, or be mistaken for, a clinical release. A unit that was
/// held before release still has to pass the Sprint 7 gate afterwards.
///
/// Rows are never deleted. A hold that was raised and lifted is part of the
/// unit's history and stays answerable.
model BloodUnitHold {
  id               String              @id @default(cuid())
  bloodUnitId      String
  organizationId   String
  kind             BloodUnitHoldKind
  status           BloodUnitHoldStatus @default(ACTIVE)
  /// Machine-readable, from a vocabulary that ships empty. The clinical
  /// meaning of a hold reason is a reviewer's answer (CR-07).
  reasonCode       String?             @db.VarChar(80)
  reasonText       String?
  raisedBy         String?
  raisedAt         DateTime            @default(now())
  resolvedBy       String?
  resolvedAt       DateTime?
  resolutionText   String?
  /// The cold-chain observation that caused this hold, when one did.
  coldChainEventId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  bloodUnit      BloodUnit           @relation(fields: [bloodUnitId], references: [id], onDelete: Restrict)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  raiser         User?               @relation("BloodUnitHoldRaiser", fields: [raisedBy], references: [id], onDelete: SetNull)
  resolver       User?               @relation("BloodUnitHoldResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)
  coldChainEvent ColdChainEvent?     @relation(fields: [coldChainEventId], references: [id], onDelete: SetNull)
  movements      InventoryMovement[]

  @@index([bloodUnitId])
  @@index([organizationId])
  @@index([status])
  @@index([kind])
  @@index([raisedAt])
}

/// A temperature or integrity observation, recorded as a fact.
///
/// NO THRESHOLD IS ENCODED. This model cannot decide whether a reading is
/// safe, because what is safe is a clinical value nobody has signed off
/// (CR-06). `excursionDeclared` is therefore an assertion by an authorized
/// person or device, not a comparison this code performs -- and when it is
/// true, the unit goes into a TEMPERATURE_EXCURSION hold.
model ColdChainEvent {
  id                   String             @id @default(cuid())
  bloodUnitId          String?
  shipmentId           String?
  organizationId       String
  type                 ColdChainEventType
  /// References to the physical equipment. Free-form: what a storage device or
  /// data logger identifier looks like is operational (OR-03).
  deviceReference      String?            @db.VarChar(120)
  containerReference   String?            @db.VarChar(120)
  loggerReference      String?            @db.VarChar(120)
  measuredAt           DateTime
  /// Recorded to one decimal place. A number, with no rule attached to it.
  temperatureC         Decimal?           @db.Decimal(5, 1)
  source               TemperatureSource  @default(UNKNOWN)
  /// When the logger was last calibrated, and against what. A reading from an
  /// uncalibrated device is still a reading; whether it can be relied on is
  /// the quality workflow's judgement, not this row's.
  calibratedAt         DateTime?
  calibrationReference String?            @db.VarChar(120)
  sealIntact           ContainerIntegrity @default(UNKNOWN)
  /// Asserted by the person or device recording it. Never computed here.
  excursionDeclared    Boolean            @default(false)
  actorId              String?
  notes                String?
  createdAt            DateTime           @default(now())

  bloodUnit    BloodUnit?          @relation(fields: [bloodUnitId], references: [id], onDelete: Restrict)
  shipment     Shipment?           @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?               @relation("ColdChainEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  holds        BloodUnitHold[]
  movements    InventoryMovement[]

  @@index([bloodUnitId])
  @@index([shipmentId])
  @@index([organizationId])
  @@index([type])
  @@index([measuredAt])
  @@index([excursionDeclared])
}

/// A consent document, versioned and approved before it can be relied on.
///
/// NO LEGAL WORDING IS AUTHORED HERE, and none ships. What a deployment
/// presents to a donor is a document its own counsel wrote; this model records
/// which one, in which language, at which version, and whether anybody with
/// authority approved it.
///
/// `contentHash` is what makes a version immutable in practice: the text can
/// live in this row or behind `contentReference`, but either way the hash is
/// what an acceptance is bound to, so nobody can quietly edit the wording
/// somebody already agreed to and keep the agreement.
///
/// Approval is never automatic. A document is created DRAFT and stays DRAFT
/// until a person approves it, and production refuses to record an acceptance
/// against anything but an APPROVED one -- the same fail-closed shape as the
/// Sprint 7 clinical release policy, for the same reason.
model ConsentDocument {
  id               String                @id @default(cuid())
  purpose          ConsentPurpose
  organizationId   String?
  /// `organizationId`, or the literal 'PLATFORM'. See StoragePolicy.scopeKey.
  scopeKey         String
  /// BCP 47. Uzbek, Russian and English are what this product ships in; the
  /// column does not constrain that, because which languages a deployment must
  /// offer is a legal question (LP-04).
  locale           String                @db.VarChar(16)
  version          Int
  /// The wording, or a pointer to where it lives. Exactly one is expected;
  /// neither is required by the schema, because a deployment may hold the
  /// authoritative text in a document management system.
  content          String?
  contentReference String?
  /// SHA-256 of the exact text this version presents. An acceptance stores it
  /// too, so a mismatch is detectable rather than silent.
  contentHash      String                @db.VarChar(64)
  status           ConsentDocumentStatus @default(DRAFT)
  effectiveAt      DateTime?
  approvedBy       String?
  approvedAt       DateTime?
  retiredAt        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  approver     User?               @relation("ConsentDocumentApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  acceptances  ConsentAcceptance[]

  @@unique([scopeKey, purpose, locale, version])
  @@index([purpose])
  @@index([status])
  @@index([organizationId])
  @@index([effectiveAt])
}

/// That a person agreed to a specific version of a specific document.
///
/// Never updated in place and never deleted. Withdrawing consent sets
/// `withdrawnAt`; it does not remove the row, because "did this person ever
/// consent, to what, and when did they change their mind" has to stay
/// answerable -- which is the whole evidentiary point of a consent record.
///
/// The document's purpose, version, locale and content hash are COPIED onto
/// this row rather than only referenced. The audit found that mirroring
/// ReleaseDecision literally would inherit `onDelete: Cascade` from
/// Organization, so deleting an organization would destroy the evidence that
/// somebody consented. The organization link is `Restrict` here and the facts
/// are denormalised, so the record survives the document being retired, the
/// wording being superseded, and the organization being wound up.
model ConsentAcceptance {
  id              String                  @id @default(cuid())
  userId          String
  documentId      String
  /// Denormalised, deliberately. See the model note.
  purpose         ConsentPurpose
  documentVersion Int
  locale          String                  @db.VarChar(16)
  contentHash     String                  @db.VarChar(64)
  organizationId  String?
  acceptedAt      DateTime                @default(now())
  withdrawnAt     DateTime?
  source          ConsentAcceptanceSource @default(MOBILE_APP)
  /// Where the acceptance came from. Deliberately coarse: a client name and a
  /// version, not an IP address or a device fingerprint, because collecting
  /// more to prove consent than the consent itself is worth is its own privacy
  /// problem.
  clientReference String?                 @db.VarChar(120)
  context         String?
  /// Set when a staff member recorded the acceptance on someone's behalf,
  /// which is a materially different act from the person tapping it themselves.
  recordedBy      String?
  createdAt       DateTime                @default(now())

  user         User            @relation("ConsentAcceptanceUser", fields: [userId], references: [id], onDelete: Restrict)
  document     ConsentDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)
  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recorder     User?           @relation("ConsentAcceptanceRecorder", fields: [recordedBy], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([documentId])
  @@index([purpose])
  @@index([acceptedAt])
  @@index([withdrawnAt])
}

/// How strongly this deployment requires a purpose.
///
/// Configuration, not law. Whether a blood service may lawfully refuse to
/// register a donor who declines a given purpose is a question for counsel
/// (LP-01, LP-02), and this row is where their answer will land. Until it
/// does, the posture is the product owner's and is recorded as such.
///
/// Soft-retired rather than deleted: an acceptance is only interpretable
/// against the mode that was in force when it was given, and the audit found
/// that the obvious template for this model -- InventoryThreshold -- exposes a
/// hard delete that would erase exactly that context.
model ConsentRequirement {
  id             String                 @id @default(cuid())
  purpose        ConsentPurpose
  organizationId String?
  scopeKey       String
  mode           ConsentRequirementMode
  /// The feature this purpose gates, when it gates one. Free-form so a
  /// deployment can name its own features without a schema change.
  featureKey     String?                @db.VarChar(80)
  note           String?
  retiredAt      DateTime?
  retiredBy      String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([scopeKey, purpose, featureKey])
  @@index([purpose])
  @@index([mode])
  @@index([organizationId])
}

/// What may be done with a category of data, by reference.
///
/// NO PERIOD IS ENCODED AND NONE SHIPS. How long a blood service must keep a
/// donation record, and how long it may keep a phone number, are legal answers
/// this project does not have (LP-06). `RetentionMode` says what class of
/// treatment a category is under; `authorityReference` is where the rule that
/// says so is cited. A category with no row is not deletable by default --
/// absence of a policy is not permission.
model RetentionPolicy {
  id                 String        @id @default(cuid())
  /// The data category this governs -- a key, not an enum, so a deployment can
  /// describe its own data map without a migration.
  category           String        @db.VarChar(80)
  organizationId     String?
  scopeKey           String
  mode               RetentionMode
  /// Citation for the rule. Empty until counsel supplies one.
  authorityReference String?
  /// Set while a legal hold suspends any deletion for this category.
  legalHoldUntil     DateTime?
  legalHoldReason    String?
  note               String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([scopeKey, category])
  @@index([category])
  @@index([mode])
}

/// The low-stock threshold for one organization, at one level of specificity.
///
/// Replaces `const LOW_STOCK_THRESHOLD = 5`, which was a number nobody chose
/// applied to every organization, every blood group and every component at
/// once. Five units of O-negative and five units of AB-positive are not the
/// same situation, and the right number is a property of the site, not of this
/// repository.
///
/// Resolution is most-specific-first: an exact (type, Rh, component) row beats
/// a (type, Rh) row, which beats the organization default. `scopeKey` encodes
/// which level a row is at -- see `InventoryThresholdService` -- and exists for
/// the same reason it does on `ClinicalReleasePolicy`: Postgres would not
/// enforce uniqueness across nullable columns.
///
/// NO THRESHOLD IS SEEDED FOR PRODUCTION. With nothing configured, the alert
/// engine raises `LOW_STOCK_THRESHOLD_NOT_CONFIGURED` instead of comparing
/// stock against a number it made up.
model InventoryThreshold {
  id                String         @id @default(cuid())
  organizationId    String
  /// "ORG" | "TYPE:<bloodType>:<rhFactor>" | "TYPE:<bloodType>:<rhFactor>:<componentType>"
  scopeKey          String         @db.VarChar(80)
  bloodType         BloodType?
  rhFactor          RhFactor?
  componentType     ComponentType?
  lowStockThreshold Int
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User?        @relation("InventoryThresholdCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updater      User?        @relation("InventoryThresholdUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([organizationId, scopeKey])
  @@index([organizationId])
}

model InventoryAlert {
  id             String     @id @default(cuid())
  organizationId String
  type           AlertType
  bloodType      BloodType?
  rhFactor       RhFactor?
  message        String
  threshold      Int?
  currentValue   Int?
  acknowledged   Boolean    @default(false)
  acknowledgedAt DateTime?
  acknowledgedBy String?
  createdAt      DateTime   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([type])
  @@index([acknowledged])
}

model BloodRequest {
  id                       String               @id @default(cuid())
  requestReference         String               @unique
  requestingOrganizationId String
  fulfillingOrganizationId String?
  priority                 BloodRequestPriority @default(ROUTINE)
  status                   BloodRequestStatus   @default(DRAFT)
  notes                    String?
  deliveryAddress          String?
  deliveryLatitude         Decimal?             @db.Decimal(9, 6)
  deliveryLongitude        Decimal?             @db.Decimal(9, 6)
  deliveryPhone            String?
  expectedDeliveryDate     DateTime?
  deliveredAt              DateTime?
  cancelledAt              DateTime?
  cancellationReason       String?
  // Rejection is the fulfilling centre declining the request; cancellation is
  // the requesting hospital withdrawing it. Sharing one pair of columns would
  // make the two indistinguishable in the record, which is the one thing a
  // hospital reading back a refused request needs to be able to tell.
  rejectedAt               DateTime?
  rejectedById             String?
  rejectionReason          String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  rejectedBy             User?               @relation("RejectedBloodRequests", fields: [rejectedById], references: [id], onDelete: SetNull)
  requestingOrganization Organization        @relation("RequestingOrganization", fields: [requestingOrganizationId], references: [id], onDelete: Cascade)
  fulfillingOrganization Organization?       @relation("FulfillingOrganization", fields: [fulfillingOrganizationId], references: [id], onDelete: SetNull)
  items                  BloodRequestItem[]
  events                 BloodRequestEvent[]
  shipment               Shipment?

  unitDispositions BloodUnitDisposition[]

  @@index([requestingOrganizationId])
  @@index([fulfillingOrganizationId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model BloodRequestItem {
  id             String        @id @default(cuid())
  bloodRequestId String
  bloodType      BloodType
  rhFactor       RhFactor
  componentType  ComponentType @default(WHOLE_BLOOD)
  unitsRequested Int
  unitsApproved  Int           @default(0)
  unitsFulfilled Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  bloodRequest  BloodRequest           @relation(fields: [bloodRequestId], references: [id], onDelete: Cascade)
  reservations  BloodUnitReservation[]
  shipmentUnits ShipmentUnit[]

  @@index([bloodRequestId])
  @@index([bloodType])
  @@index([rhFactor])
}

model BloodRequestEvent {
  id             String   @id @default(cuid())
  bloodRequestId String
  eventType      String
  actorId        String?
  organizationId String?
  metadata       Json?
  createdAt      DateTime @default(now())

  bloodRequest BloodRequest  @relation(fields: [bloodRequestId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([bloodRequestId])
  @@index([actorId])
  @@index([createdAt])
}

model Courier {
  id                String        @id @default(cuid())
  userId            String        @unique
  organizationId    String
  displayName       String
  phone             String?
  status            CourierStatus @default(OFFLINE)
  currentShipmentId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shipments    Shipment[]
  locations    ShipmentLocation[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
}

model Shipment {
  id                        String                 @id @default(cuid())
  shipmentReference         String                 @unique
  bloodRequestId            String                 @unique
  sourceOrganizationId      String
  destinationOrganizationId String
  courierId                 String?
  status                    ShipmentStatus         @default(CREATED)
  pickupAddress             String?
  pickupLatitude            Decimal?               @db.Decimal(9, 6)
  pickupLongitude           Decimal?               @db.Decimal(9, 6)
  destinationAddress        String?
  destinationLatitude       Decimal?               @db.Decimal(9, 6)
  destinationLongitude      Decimal?               @db.Decimal(9, 6)
  assignedAt                DateTime?
  acceptedAt                DateTime?
  declinedAt                DateTime?
  declineReason             String?
  pickupStartedAt           DateTime?
  pickedUpAt                DateTime?
  inTransitAt               DateTime?
  arrivedAt                 DateTime?
  deliveredAt               DateTime?
  failedAt                  DateTime?
  failureReason             DeliveryFailureReason?
  failureNotes              String?
  cancelledAt               DateTime?
  cancellationReason        String?
  estimatedArrivalAt        DateTime?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  bloodRequest            BloodRequest       @relation(fields: [bloodRequestId], references: [id], onDelete: Cascade)
  sourceOrganization      Organization       @relation("ShipmentSource", fields: [sourceOrganizationId], references: [id], onDelete: Cascade)
  destinationOrganization Organization       @relation("ShipmentDestination", fields: [destinationOrganizationId], references: [id], onDelete: Cascade)
  courier                 Courier?           @relation(fields: [courierId], references: [id], onDelete: SetNull)
  units                   ShipmentUnit[]
  events                  ShipmentEvent[]
  locations               ShipmentLocation[]
  coldChainEvents         ColdChainEvent[]

  unitDispositions BloodUnitDisposition[]

  @@index([bloodRequestId])
  @@index([sourceOrganizationId])
  @@index([destinationOrganizationId])
  @@index([courierId])
  @@index([status])
  @@index([shipmentReference])
  @@index([createdAt])
}

model ShipmentUnit {
  id            String    @id @default(cuid())
  shipmentId    String
  bloodUnitId   String
  reservationId String
  pickedUpAt    DateTime?
  deliveredAt   DateTime?
  status        String    @default("PENDING")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  shipment           Shipment             @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  bloodUnit          BloodUnit            @relation(fields: [bloodUnitId], references: [id], onDelete: Cascade)
  reservation        BloodUnitReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  bloodRequestItem   BloodRequestItem?    @relation(fields: [bloodRequestItemId], references: [id], onDelete: SetNull)
  bloodRequestItemId String?

  @@unique([shipmentId, bloodUnitId])
  @@index([shipmentId])
  @@index([bloodUnitId])
  @@index([reservationId])
}

model ShipmentEvent {
  id             String            @id @default(cuid())
  shipmentId     String
  eventType      ShipmentEventType
  actorId        String?
  organizationId String?
  metadata       Json?
  createdAt      DateTime          @default(now())

  shipment     Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([actorId])
  @@index([createdAt])
}

model ShipmentLocation {
  id         String   @id @default(cuid())
  shipmentId String
  courierId  String
  latitude   Decimal  @db.Decimal(9, 6)
  longitude  Decimal  @db.Decimal(9, 6)
  accuracy   Decimal? @db.Decimal(8, 2)
  heading    Decimal? @db.Decimal(5, 2)
  speed      Decimal? @db.Decimal(6, 2)
  recordedAt DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  courier  Courier  @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([courierId])
  @@index([recordedAt])
}

model EmergencyRequest {
  id                 String          @id @default(cuid())
  emergencyReference String          @unique
  hospitalId         String
  bloodType          BloodType
  rhFactor           RhFactor
  componentType      ComponentType   @default(WHOLE_BLOOD)
  unitsRequired      Int
  urgencyLevel       String          @default("CRITICAL")
  status             EmergencyStatus @default(DRAFT)
  patientReference   String?
  description        String?
  requiredBefore     DateTime?
  donationLocation   String?
  latitude           Decimal?        @db.Decimal(9, 6)
  longitude          Decimal?        @db.Decimal(9, 6)
  unitsCommitted     Int             @default(0)
  unitsArrived       Int             @default(0)
  unitsCollected     Int             @default(0)
  createdBy          String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  closedAt           DateTime?
  cancelledAt        DateTime?

  hospital  Organization        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  creator   User                @relation("EmergencyCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  matches   EmergencyMatch[]
  responses EmergencyResponse[]

  @@index([hospitalId])
  @@index([bloodType])
  @@index([rhFactor])
  @@index([status])
  @@index([urgencyLevel])
  @@index([createdAt])
}

model EmergencyMatch {
  id                 String               @id @default(cuid())
  emergencyRequestId String
  donorId            String
  matchScore         Float?
  distanceKm         Float?
  status             EmergencyMatchStatus @default(MATCHED)
  notifiedAt         DateTime?
  viewedAt           DateTime?
  respondedAt        DateTime?
  expiredAt          DateTime?
  createdAt          DateTime             @default(now())

  emergencyRequest EmergencyRequest   @relation(fields: [emergencyRequestId], references: [id], onDelete: Cascade)
  donor            User               @relation("EmergencyDonor", fields: [donorId], references: [id], onDelete: Cascade)
  response         EmergencyResponse?

  @@unique([emergencyRequestId, donorId])
  @@index([emergencyRequestId])
  @@index([donorId])
  @@index([status])
  @@index([createdAt])
}

model EmergencyResponse {
  id                 String                  @id @default(cuid())
  emergencyRequestId String
  matchId            String?                 @unique
  donorId            String
  status             EmergencyResponseStatus @default(ACCEPTED)
  acceptedAt         DateTime?
  enRouteAt          DateTime?
  arrivedAt          DateTime?
  donationStartedAt  DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  emergencyRequest EmergencyRequest    @relation(fields: [emergencyRequestId], references: [id], onDelete: Cascade)
  donor            User                @relation("EmergencyResponseDonor", fields: [donorId], references: [id], onDelete: Cascade)
  match            EmergencyMatch?     @relation(fields: [matchId], references: [id], onDelete: SetNull)
  locations        EmergencyLocation[]
  donation         Donation?

  @@index([emergencyRequestId])
  @@index([donorId])
  @@index([status])
  @@index([createdAt])
}

model EmergencyLocation {
  id                  String   @id @default(cuid())
  emergencyResponseId String
  latitude            Decimal  @db.Decimal(9, 6)
  longitude           Decimal  @db.Decimal(9, 6)
  accuracy            Decimal? @db.Decimal(8, 2)
  heading             Decimal? @db.Decimal(5, 2)
  speed               Decimal? @db.Decimal(6, 2)
  recordedAt          DateTime @default(now())

  emergencyResponse EmergencyResponse @relation(fields: [emergencyResponseId], references: [id], onDelete: Cascade)

  @@index([emergencyResponseId])
  @@index([recordedAt])
}

model TestType {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  description  String?
  category     TestCategory @default(GENERAL)
  isActive     Boolean      @default(true)
  displayOrder Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  parameters         TestParameter[]
  referenceRanges    TestReferenceRange[]
  laboratoryProfiles LaboratoryProfile[]
  laboratoryResults  LaboratoryResult[]
  appointments       Appointment[]

  @@index([category])
  @@index([isActive])
}

model TestParameter {
  id           String   @id @default(cuid())
  testTypeId   String
  code         String
  name         String
  description  String?
  unit         String?
  dataType     String   @default("numeric")
  required     Boolean  @default(true)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  testType        TestType               @relation(fields: [testTypeId], references: [id], onDelete: Cascade)
  resultItems     LaboratoryResultItem[]
  referenceRanges TestReferenceRange[]

  @@unique([testTypeId, code])
  @@index([testTypeId])
}

model TestReferenceRange {
  id            String    @id @default(cuid())
  testTypeId    String
  // A range belongs to one parameter. Without this the only range available
  // was the test type's, so a Complete Blood Count had a single min/max that
  // got compared against haemoglobin, platelets and white cells alike --
  // ranges three orders of magnitude apart. Null still means "applies to the
  // whole test type", which is right for a single-parameter test.
  parameterId   String?
  laboratoryId  String?
  minValue      Decimal?  @db.Decimal(10, 3)
  maxValue      Decimal?  @db.Decimal(10, 3)
  unit          String?
  notes         String?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  testType   TestType       @relation(fields: [testTypeId], references: [id], onDelete: Cascade)
  parameter  TestParameter? @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  laboratory Organization?  @relation(fields: [laboratoryId], references: [id], onDelete: SetNull)

  @@index([testTypeId])
  @@index([parameterId])
  @@index([laboratoryId])
  @@index([isActive])
}

model LaboratoryProfile {
  id             String   @id @default(cuid())
  organizationId String   @unique
  name           String
  address        String?
  phone          String?
  email          String?
  workingHours   String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  testTypes    TestType[]

  @@index([organizationId])
}

model LaboratoryResult {
  id            String                 @id @default(cuid())
  appointmentId String                 @unique
  donorId       String
  laboratoryId  String
  testTypeId    String
  status        LaboratoryResultStatus @default(PENDING)
  performedAt   DateTime?
  performedBy   String?
  reviewedAt    DateTime?
  reviewedBy    String?
  publishedAt   DateTime?
  publishedBy   String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  appointment Appointment               @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  donor       User                      @relation("LaboratoryResultDonor", fields: [donorId], references: [id], onDelete: Cascade)
  laboratory  Organization              @relation("LaboratoryResultOrganization", fields: [laboratoryId], references: [id], onDelete: Cascade)
  testType    TestType                  @relation(fields: [testTypeId], references: [id], onDelete: Cascade)
  items       LaboratoryResultItem[]
  versions    LaboratoryResultVersion[]

  @@index([donorId])
  @@index([laboratoryId])
  @@index([testTypeId])
  @@index([status])
  @@index([appointmentId])
  @@index([publishedAt])
}

model LaboratoryResultItem {
  id           String     @id @default(cuid())
  resultId     String
  parameterId  String
  value        String?
  numericValue Decimal?   @db.Decimal(15, 4)
  unit         String?
  referenceMin Decimal?   @db.Decimal(10, 3)
  referenceMax Decimal?   @db.Decimal(10, 3)
  flag         ResultFlag @default(NOT_AVAILABLE)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  result    LaboratoryResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  parameter TestParameter    @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  @@index([resultId])
  @@index([parameterId])
}

model LaboratoryResultVersion {
  id           String                 @id @default(cuid())
  resultId     String
  version      Int
  status       LaboratoryResultStatus
  changeReason String?
  changedBy    String?
  createdAt    DateTime               @default(now())

  result LaboratoryResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@unique([resultId, version])
  @@index([resultId])
}

enum AchievementType {
  DONATION_COUNT
  EMERGENCY_RESPONSE_COUNT
  BLOOD_TEST_COUNT
  APPOINTMENT_COMPLETION_COUNT
  XP_MILESTONE
  STREAK
  CUSTOM_EVENT
  CHALLENGE_COMPLETED
  CAMPAIGN_PARTICIPATED
  EDUCATION_COMPLETED
}

enum AchievementRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum AchievementStatus {
  LOCKED
  IN_PROGRESS
  UNLOCKED
}

enum XpTransactionType {
  DONATION_COMPLETED
  EMERGENCY_DONATION_COMPLETED
  BLOOD_TEST_COMPLETED
  APPOINTMENT_COMPLETED
  PROFILE_COMPLETED
  ACHIEVEMENT_UNLOCKED
  ADMIN_ADJUSTMENT
  EMERGENCY_RESPONSE_ACCEPTED
  STREAK_BONUS
  CHALLENGE_COMPLETED
  CAMPAIGN_PARTICIPATED
  EDUCATION_COMPLETED
}

enum ReputationType {
  VERIFIED_CONTRIBUTION
  EMERGENCY_RESPONSE
  APPOINTMENT_ATTENDANCE
  COMMUNITY_ACTION
  ADMIN_ADJUSTMENT
}

model GamificationProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  totalXp               Int      @default(0)
  level                 Int      @default(1)
  reputationScore       Int      @default(0)
  leaderboardVisibility Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([totalXp])
  @@index([level])
}

model XpTransaction {
  id          String            @id @default(cuid())
  userId      String
  amount      Int
  type        XpTransactionType
  sourceType  String?
  sourceId    String?
  description String?
  metadata    Json?
  createdAt   DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Scoped by userId. Without it, sourceIds that are platform-wide rather than
  // per-user -- an achievement code, a challenge id, an education content id --
  // let the first donor in the whole system to reach that milestone claim the
  // XP and silently deny it to everyone after them.
  @@unique([userId, sourceType, sourceId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Achievement {
  id           String            @id @default(cuid())
  code         String            @unique
  type         AchievementType
  name         String
  description  String
  icon         String
  rarity       AchievementRarity @default(COMMON)
  criteria     Json
  xpReward     Int               @default(0)
  displayOrder Int               @default(0)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  unlocks AchievementUnlock[]
  badges  Badge[]
  posts   CommunityPost[]

  @@index([type])
  @@index([isActive])
  @@index([displayOrder])
}

model AchievementUnlock {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  progress      Int      @default(0)
  target        Int      @default(1)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

model Badge {
  id            String            @id @default(cuid())
  code          String            @unique
  name          String
  description   String
  icon          String
  rarity        AchievementRarity @default(COMMON)
  achievementId String?
  displayOrder  Int               @default(0)
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  achievement Achievement? @relation(fields: [achievementId], references: [id], onDelete: SetNull)
  userBadges  UserBadge[]
  challenges  Challenge[]

  @@index([isActive])
  @@index([displayOrder])
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

model ReputationTransaction {
  id         String         @id @default(cuid())
  userId     String
  amount     Int
  type       ReputationType
  sourceType String?
  sourceId   String?
  reason     String?
  metadata   Json?
  createdAt  DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ============================================================================
// COMMUNITY & GAMIFICATION EXPANSION (Phase 18)
// ============================================================================

enum CommunityPostType {
  CAMPAIGN
  EDUCATION
  MILESTONE
  ACHIEVEMENT
  COMMUNITY_UPDATE
  ANNOUNCEMENT
  IMPACT
}

enum CommunityPostStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  REMOVED
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ChallengeType {
  DONATION_MILESTONE
  CAMPAIGN_PARTICIPATION
  EDUCATION
  COMMUNITY
  APPOINTMENT_COMPLETION
  CONSISTENCY
}

enum ChallengeStatus {
  DRAFT
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum ChallengeVisibility {
  PUBLIC
  ORGANIZATION
  PRIVATE
}

enum ContentReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTIONED
}

enum ContentReportReason {
  SPAM
  HARASSMENT
  MISINFORMATION
  INAPPROPRIATE
  OTHER
}

enum EducationContentType {
  ARTICLE
  QUIZ
  VIDEO
}

enum EducationProgressStatus {
  STARTED
  COMPLETED
}

model CommunityPost {
  id             String              @id @default(cuid())
  type           CommunityPostType
  title          String
  body           String
  imageUrl       String?
  authorId       String?
  organizationId String?
  campaignId     String?
  achievementId  String?
  status         CommunityPostStatus @default(PUBLISHED)
  metadata       Json?
  publishedAt    DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  author       User?           @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  organization Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  campaign     Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  achievement  Achievement?    @relation(fields: [achievementId], references: [id], onDelete: SetNull)
  reports      ContentReport[]

  @@index([type])
  @@index([status])
  @@index([publishedAt])
  @@index([organizationId])
  @@index([campaignId])
}

model Campaign {
  id                 String         @id @default(cuid())
  organizationId     String
  title              String
  description        String
  imageUrl           String?
  startDate          DateTime
  endDate            DateTime
  location           String?
  latitude           Decimal?       @db.Decimal(9, 6)
  longitude          Decimal?       @db.Decimal(9, 6)
  bloodGroupsNeeded  BloodType[]
  targetParticipants Int?
  status             CampaignStatus @default(DRAFT)
  metadata           Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  participants CampaignParticipant[]
  posts        CommunityPost[]

  @@index([organizationId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model CampaignParticipant {
  id          String    @id @default(cuid())
  campaignId  String
  userId      String
  status      String    @default("JOINED")
  joinedAt    DateTime  @default(now())
  completedAt DateTime?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
}

model Challenge {
  id             String              @id @default(cuid())
  title          String
  description    String
  type           ChallengeType
  status         ChallengeStatus     @default(DRAFT)
  visibility     ChallengeVisibility @default(PUBLIC)
  organizationId String?
  startDate      DateTime?
  endDate        DateTime?
  goal           Int                 @default(1)
  xpReward       Int                 @default(0)
  badgeId        String?
  metadata       Json?
  createdBy      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  badge        Badge?                 @relation(fields: [badgeId], references: [id], onDelete: SetNull)
  creator      User?                  @relation("ChallengeCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  participants ChallengeParticipant[]

  @@index([type])
  @@index([status])
  @@index([visibility])
  @@index([organizationId])
  @@index([startDate])
  @@index([endDate])
}

model ChallengeParticipant {
  id          String    @id @default(cuid())
  challengeId String
  userId      String
  progress    Int       @default(0)
  completedAt DateTime?
  joinedAt    DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([challengeId])
  @@index([userId])
  @@index([completedAt])
}

model EducationalContent {
  id               String               @id @default(cuid())
  type             EducationContentType
  title            String
  description      String
  body             String
  imageUrl         String?
  category         String
  difficulty       String               @default("BEGINNER")
  xpReward         Int                  @default(0)
  estimatedMinutes Int?
  isActive         Boolean              @default(true)
  displayOrder     Int                  @default(0)
  metadata         Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  progress EducationProgress[]

  @@index([type])
  @@index([category])
  @@index([isActive])
  @@index([displayOrder])
}

model EducationProgress {
  id          String                  @id @default(cuid())
  userId      String
  contentId   String
  status      EducationProgressStatus @default(STARTED)
  startedAt   DateTime                @default(now())
  completedAt DateTime?
  xpAwarded   Int                     @default(0)

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  content EducationalContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
  @@index([status])
}

model ContentReport {
  id          String              @id @default(cuid())
  postId      String
  reporterId  String
  reason      ContentReportReason
  description String?
  status      ContentReportStatus @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  resolution  String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  post     CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter User          @relation("ContentReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer User?         @relation("ContentReportReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([reporterId])
  @@index([status])
  @@index([createdAt])
}

enum NotificationType {
  EMERGENCY
  DONATION
  APPOINTMENT
  LABORATORY
  AI
  GAMIFICATION
  BLOOD_REQUEST
  SHIPMENT
  INVENTORY
  SECURITY
  SYSTEM
  COMMUNITY
  CAMPAIGN
  CHALLENGE
  EDUCATION
}

enum NotificationPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  ARCHIVED
  EXPIRED
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  INVALID_TOKEN
}

model PushDevice {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String
  deviceId   String?
  appVersion String?
  locale     String   @default("en")
  timezone   String?
  isActive   Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([isActive])
  @@index([lastSeenAt])
}

model Notification {
  id             String               @id @default(cuid())
  recipientId    String
  type           NotificationType
  priority       NotificationPriority @default(NORMAL)
  title          String
  body           String
  data           Json?
  deepLink       String?
  status         NotificationStatus   @default(PENDING)
  readAt         DateTime?
  expiresAt      DateTime?
  sourceType     String?
  sourceId       String?
  idempotencyKey String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  deliveries NotificationDelivery[]

  @@unique([recipientId, idempotencyKey])
  @@index([recipientId])
  @@index([type])
  @@index([priority])
  @@index([status])
  @@index([createdAt])
  @@index([idempotencyKey])
}

model NotificationDelivery {
  id             String         @id @default(cuid())
  notificationId String
  channel        String
  status         DeliveryStatus @default(PENDING)
  providerId     String?
  attempts       Int            @default(0)
  lastAttemptAt  DateTime?
  deliveredAt    DateTime?
  failedAt       DateTime?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([status])
}

// ============================================================================
// AI HEALTH INTELLIGENCE (Phase 19)
// ============================================================================

enum AIInsightType {
  TREND_SUMMARY
  RESULT_EXPLANATION
  DATA_CHANGE
  DONATION_INSIGHT
  APPOINTMENT_INSIGHT
  HEALTH_SUMMARY
  WEEKLY_SUMMARY
  QUESTION_SUGGESTION
  GENERAL_HEALTH_INFORMATION
}

enum AIInsightStatus {
  PENDING
  GENERATING
  COMPLETED
  FAILED
  EXPIRED
}

enum AISafetyLevel {
  SAFE_INFORMATIONAL
  NEEDS_CONTEXT
  PROFESSIONAL_REVIEW_SUGGESTED
  EMERGENCY_REDIRECT
  OUT_OF_SCOPE
}

model AIInsight {
  id                       String          @id @default(cuid())
  userId                   String
  type                     AIInsightType
  status                   AIInsightStatus @default(PENDING)
  title                    String?
  summary                  String?
  observations             Json? // string[]
  dataPoints               Json? // DataPoint[]
  caveats                  Json? // string[]
  questionsForProfessional Json? // string[]
  safetyLevel              AISafetyLevel   @default(SAFE_INFORMATIONAL)
  dataVersion              String?
  dataReferences           Json? // DataReference[]
  sourceType               String? // BLOOD_TEST, DONATION, APPOINTMENT, etc.
  sourceId                 String?
  promptVersion            String? // e.g. health-test-analysis-v1
  model                    String? // model that generated this insight
  errorMessage             String?
  generatedAt              DateTime?
  expiresAt                DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedback AIFeedback?

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([sourceType, sourceId])
  @@index([promptVersion])
  @@index([model])
}

model AIRequestLog {
  id                 String         @id @default(cuid())
  userId             String?
  requestId          String         @unique
  insightType        AIInsightType?
  providerName       String
  modelUsed          String?
  promptVersion      String?
  promptTokens       Int?
  completionTokens   Int?
  totalTokens        Int?
  latencyMs          Int?
  success            Boolean
  errorMessage       String?
  safetyLevel        AISafetyLevel?
  dataVersion        String?
  requestFingerprint String? // for deduplication
  createdAt          DateTime       @default(now())

  @@index([userId])
  @@index([insightType])
  @@index([createdAt])
  @@index([success])
  @@index([requestFingerprint])
  @@index([promptVersion])
}

model AIInsightCache {
  id            String        @id @default(cuid())
  cacheKey      String        @unique
  userId        String
  insightType   AIInsightType
  dataVersion   String
  promptVersion String? // invalidate when prompt changes
  model         String? // invalidate when model changes
  response      Json
  expiresAt     DateTime
  createdAt     DateTime      @default(now())

  @@index([userId])
  @@index([cacheKey])
  @@index([expiresAt])
  @@index([promptVersion])
}

model AIConversation {
  id            String    @id @default(cuid())
  userId        String
  title         String?
  contextType   String? // GENERAL, TREND, RESULT, DONATION, etc.
  contextId     String? // ID of the referenced context (parameter code, result ID, etc.)
  lastMessageAt DateTime?
  messageCount  Int       @default(0)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId])
  @@index([createdAt])
  @@index([expiresAt])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           String // user, assistant, system
  content        String
  safetyLevel    AISafetyLevel?
  promptVersion  String?
  model          String?
  createdAt      DateTime       @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@index([role])
}

enum AIFeedbackType {
  HELPFUL
  NOT_HELPFUL
  REPORT_ISSUE
}

model AIFeedback {
  id        String         @id @default(cuid())
  userId    String
  insightId String         @unique
  type      AIFeedbackType
  reason    String? // optional reason for not helpful / report
  createdAt DateTime       @default(now())

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  insight AIInsight @relation(fields: [insightId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([insightId])
  @@index([type])
  @@index([createdAt])
}

enum PhoneVerificationPurpose {
  REGISTRATION
  PASSWORD_RESET
}

/// A one-time code sent to a phone number, and what has happened to it.
///
/// Keyed by the number rather than by a user, because registration is the main
/// case and the account does not exist yet. The code itself is never stored:
/// `codeHash` is an HMAC, so a database copy is not a list of valid codes.
///
/// Rows are kept after they are spent. "Was a code requested for this number in
/// the last hour" is a rate-limiting question and a security question, and both
/// need the history, not just the live row.
model PhoneVerification {
  id           String                   @id @default(cuid())
  phone        String                   @db.VarChar(20)
  purpose      PhoneVerificationPurpose
  codeHash     String                   @db.VarChar(64)
  expiresAt    DateTime
  consumedAt   DateTime?
  /// Set when a newer code replaced this one, so a resend cannot leave two
  /// codes alive for the same number.
  supersededAt DateTime?
  attempts     Int                      @default(0)
  requestedIp  String?                  @db.VarChar(64)
  createdAt    DateTime                 @default(now())

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
}
