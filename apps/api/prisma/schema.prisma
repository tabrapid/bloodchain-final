model Donation {
  id                    String              @id @default(cuid())
  donationReference     String              @unique
  donorId               String
  organizationId        String
  appointmentId         String?             @unique
  /**
   * The emergency response this donation was collected for, when it was.
   * The one fact that makes a donation an emergency donation, and the reason it
   * is a column rather than a query: it used to be inferred by looking for any
   * completed emergency response by the same donor with a matching blood group,
   * unbounded in time and unlinked to this donation -- so every routine
   * donation a donor made after their first SOS response was scored as an
   * emergency one, forever, and paid emergency XP for it.
   */
  emergencyResponseId   String?             @unique
  donationType          DonationType        @default(WHOLE_BLOOD)
  status                DonationStatus      @default(SCHEDULED)
  bloodType             BloodType?
  rhFactor              RhFactor?
  volumeMl              Int?
  collectionStartedAt   DateTime?
  collectionCompletedAt DateTime?
  staffNotes            String?
  nextDonationDate      DateTime?
  cancellationReason    CancellationReason?
  cancelledAt           DateTime?
  abortedAt             DateTime?
  abortedReason         String?
  rejectedAt            DateTime?
  rejectedReason        String?
  completedAt           DateTime?
  completedBy           String?
  verifiedAt            DateTime?
  verifiedBy            String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  donor             User                @relation(fields: [donorId], references: [id], onDelete: Cascade)
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment       Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  emergencyResponse EmergencyResponse?  @relation(fields: [emergencyResponseId], references: [id], onDelete: SetNull)
  events            DonationEvent[]
  assessment        DonationAssessment?
  /// One donation, many components.
  ///
  /// This was `bloodUnit BloodUnit?` -- exactly one unit per donation, enforced
  /// by a `@unique` on the far side. That is not how a blood service works: a
  /// whole-blood collection is routinely separated into red cells, plasma and
  /// platelets, each with its own identity, its own fate and its own release
  /// decision. The old shape could not express that, and the seed and test
  /// fixtures worked around it by inventing a throwaway parent donation for
  /// every unit they needed.
  bloodUnits        BloodUnit[]
  samples           DonationSample[]
  deferrals         DonorDeferral[]

  @@index([donorId])
  @@index([organizationId])
  @@index([appointmentId])
  @@index([status])
  @@index([createdAt])
  @@index([donationReference])
  @@index([collectionCompletedAt])
  @@index([bloodType])
  @@index([emergencyResponseId])
}

