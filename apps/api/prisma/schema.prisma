model BloodUnit {
  id                   String               @id @default(cuid())
  unitReference        String               @unique
  /// No longer unique: one donation yields many components. See
  /// `Donation.bloodUnits` for why, and `completeDonation` for the conditional
  /// claim that replaced the accidental double-completion guard this
  /// constraint used to provide.
  donationId           String
  organizationId       String
  componentType        ComponentType        @default(WHOLE_BLOOD)
  bloodType            BloodType
  rhFactor             RhFactor
  volumeMl             Int
  status               BloodUnitStatus      @default(COLLECTED)
  locationId           String?
  collectedAt          DateTime
  expiresAt            DateTime?
  /// Where `expiresAt` came from. UNKNOWN whenever `expiresAt` is null, and
  /// the reason a unit with no expiry cannot be released: an unknown shelf
  /// life is not a safe one (CL-04).
  expirySource         ExpiryProvenance     @default(UNKNOWN)
  /// Where `bloodType`/`rhFactor` came from. The unit is not typed; the donor
  /// was. Recording that honestly is the whole point of this column (CL-05).
  bloodGroupSource     BloodGroupProvenance @default(UNKNOWN)
  /// The donor profile's own `bloodTypeSource` at the moment of the copy, when
  /// `bloodGroupSource` is DONOR_PROFILE_COPY. Provenance of the provenance.
  bloodGroupSourceNote String?              @db.VarChar(120)
  /// When this unit passed a clinical release evaluation. Null until it does,
  /// including for every unit that predates the gate.
  clinicalReleasedAt   DateTime?
  /// The unit this component was separated from, when it was one.
  ///
  /// A whole-blood collection arrives as one bag and is separated into
  /// components; each component is its own `BloodUnit` row pointing back at the
  /// bag it came from. Null for a unit that was collected directly.
  parentUnitId         String?
  /// When this component was prepared, which is not when the donation was
  /// collected. Null for a directly collected unit.
  preparedAt           DateTime?
  /// The storage requirement this component is held under, as a REFERENCE.
  ///
  /// Deliberately a foreign key and not a temperature. What a component must be
  /// stored at is a clinical and regulatory value this project does not have
  /// (CR-06), and `StoragePolicy` ships empty for that reason.
  storagePolicyId      String?
  /// Codes describing how the component was processed -- leucodepleted,
  /// irradiated, and so on. A vocabulary that SHIPS EMPTY: which attributes
  /// exist, and what each implies clinically, is a laboratory reviewer's
  /// answer (LR-04), not this repository's.
  processingAttributes String[]
  verifiedAt           DateTime?
  verifiedBy           String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  donation         Donation               @relation(fields: [donationId], references: [id], onDelete: Cascade)
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location         InventoryLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  verifier         User?                  @relation("BloodUnitVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)
  parentUnit       BloodUnit?             @relation("BloodUnitComponents", fields: [parentUnitId], references: [id], onDelete: Restrict)
  components       BloodUnit[]            @relation("BloodUnitComponents")
  storagePolicy    StoragePolicy?         @relation(fields: [storagePolicyId], references: [id], onDelete: Restrict)
  movements        InventoryMovement[]
  reservations     BloodUnitReservation[]
  shipmentUnits    ShipmentUnit[]
  releaseDecisions ReleaseDecision[]
  holds            BloodUnitHold[]
  coldChainEvents  ColdChainEvent[]
  disposition      BloodUnitDisposition?

  @@index([parentUnitId])
  @@index([storagePolicyId])
  @@index([donationId])
  @@index([organizationId])
  @@index([bloodType])
  @@index([status])
  @@index([collectedAt])
  @@index([locationId])
  @@index([unitReference])
  @@index([clinicalReleasedAt])
}

