  bloodUnits    BloodUnit[]
  movementsFrom InventoryMovement[] @relation("FromLocation")
  movementsTo   InventoryMovement[] @relation("ToLocation")

  @@index([organizationId])
  @@index([active])
}

/// The chain of custody. Append-only, ordered, and never the place a fact is
/// replaced rather than added.
///
/// Three things were wrong with this table before Sprint 9, and all three
/// mattered for exactly the question a ledger exists to answer.
///
/// 1. It cascaded from `BloodUnit`, so deleting a unit deleted its own history.
///    An "immutable movement history" that a `DELETE` removes is a log, not a
///    ledger. It is `Restrict` now: the history refuses to let the unit go.
/// 2. It had no total order. The only ordering column was `createdAt`, which
///    Postgres fills with transaction-start time -- identical for every row
///    written in one transaction, so a multi-event transaction produced a
///    custody history nobody could put in order. `sequence` is per-unit and
///    monotonic.
/// 3. It recorded a free-text `reason` and nothing about what actually changed,
///    so the status history lived only in `AuditLog`. `fromStatus`/`toStatus`
///    put it back where an investigator will look for it.
model InventoryMovement {
  id                 String           @id @default(cuid())
  bloodUnitId        String
  organizationId     String
  /// Monotonic per unit. Unique with `bloodUnitId`, so two concurrent writers
  /// cannot claim the same position in one unit's history.
  sequence           Int
  fromLocationId     String?
  toLocationId       String?
  type               MovementType
  /// The lifecycle transition this movement records, when it recorded one.
  fromStatus         BloodUnitStatus?
  toStatus           BloodUnitStatus?
  actorId            String?
  /// Who handed the unit over and who took it, when those are different people
  /// from whoever operated the system.
  dispatchedBy       String?
  receivedBy         String?
  dispatchedAt       DateTime?
  receivedAt         DateTime?
  /// The physical container, its seal, and the scan that was read. Free-form
  /// references: what a container or seal identifier looks like is an
  /// operational decision (OR-03), not one this schema should make.
  containerReference String?          @db.VarChar(120)
  sealReference      String?          @db.VarChar(120)
  scanReference      String?          @db.VarChar(120)
  /// The hold or cold-chain observation that occasioned this movement.
  holdId             String?
  coldChainEventId   String?
  reason             String?
  notes              String?
  createdAt          DateTime         @default(now())

  bloodUnit      BloodUnit          @relation(fields: [bloodUnitId], references: [id], onDelete: Restrict)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromLocation   InventoryLocation? @relation("FromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation     InventoryLocation? @relation("ToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  actor          User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)
  dispatcher     User?              @relation("InventoryMovementDispatcher", fields: [dispatchedBy], references: [id], onDelete: SetNull)
  receiver       User?              @relation("InventoryMovementReceiver", fields: [receivedBy], references: [id], onDelete: SetNull)
  hold           BloodUnitHold?     @relation(fields: [holdId], references: [id], onDelete: SetNull)
  coldChainEvent ColdChainEvent?    @relation(fields: [coldChainEventId], references: [id], onDelete: SetNull)

  @@unique([bloodUnitId, sequence])
  @@index([bloodUnitId])
  @@index([organizationId])
  @@index([type])
  @@index([createdAt])
  @@index([holdId])
  @@index([coldChainEventId])
}

model BloodUnitReservation {
  id                        String            @id @default(cuid())
  bloodUnitId               String
  organizationId            String
  reservedForOrganizationId String?
  status                    ReservationStatus @default(ACTIVE)
