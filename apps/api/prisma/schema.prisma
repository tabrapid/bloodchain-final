generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PENDING_VERIFICATION
}

enum OrganizationType {
  HOSPITAL
  BLOOD_CENTER
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  PENDING_APPROVAL
  DEACTIVATED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum RoleCode {
  DONOR
  HOSPITAL_ADMIN
  HOSPITAL_STAFF
  BLOOD_CENTER_ADMIN
  BLOOD_CENTER_STAFF
  COURIER
  SUPER_ADMIN
  LAB_TECHNICIAN
  LAB_REVIEWER
  LAB_ADMIN
}

enum BloodType {
  A
  B
  AB
  O
}

enum RhFactor {
  POSITIVE
  NEGATIVE
  UNKNOWN
}

enum DonorStatus {
  ACTIVE
  INACTIVE
  DEFERRED
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  REQUIRES_REVIEW
}

enum VerificationSource {
  BLOOD_CENTER
  HOSPITAL
  LABORATORY
  OTHER_AUTHORIZED_SOURCE
}

enum TestCategory {
  HEMATOLOGY
  IRON
  BLOOD_GROUP
  LIVER_FUNCTION
  KIDNEY_FUNCTION
  DIABETES
  THYROID
  LIPID
  GENERAL
  OTHER
}

enum ResultFlag {
  NORMAL
  LOW
  HIGH
  CRITICAL
  ABNORMAL
  NOT_AVAILABLE
}

enum AppointmentType {
  BLOOD_DONATION
  BLOOD_TEST
  CONSULTATION
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  RESULT_PENDING
  RESULT_READY
  RESULT_PUBLISHED
  CANCELLED
  NO_SHOW
  RESCHEDULED
  EXPIRED
}

enum SlotStatus {
  AVAILABLE
  FULL
  BLOCKED
  CANCELLED
  EXPIRED
}

enum DonationType {
  WHOLE_BLOOD
  PLASMA
  PLATELETS
  OTHER
}

enum DonationStatus {
  SCHEDULED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ABORTED
  NO_SHOW
  REJECTED
}

enum AssessmentDecision {
  APPROVED_FOR_DONATION
  DEFERRED
  NOT_COMPLETED
}

enum CancellationReason {
  DONOR_CANCELLED
  ORGANIZATION_CANCELLED
  NOT_COMPLETED
  DEFERRED
  OTHER
}

enum BloodUnitStatus {
  COLLECTED
  AVAILABLE
  RESERVED
  USED
  EXPIRED
  DISCARDED
  QUARANTINED
}

enum ComponentType {
  WHOLE_BLOOD
  RED_CELLS
  PLASMA
  PLATELETS
  OTHER
}

enum MovementType {
  RECEIVED
  MOVED
  RESERVED
  RELEASED
  USED
  EXPIRED
  DISCARDED
  QUARANTINED
  RELEASED_FROM_QUARANTINE
  TRANSFER_OUT
  TRANSFER_IN
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  FULFILLED
  EXPIRED
  CANCELLED
}

enum AlertType {
  LOW_STOCK
  EXPIRING_SOON
  EXPIRED
  QUARANTINED
}

enum BloodRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  CANCELLED
  READY_FOR_PICKUP
  IN_TRANSIT
  DELIVERED
  PARTIALLY_DELIVERED
}

enum BloodRequestPriority {
  ROUTINE
  URGENT
  CRITICAL
}

enum ShipmentStatus {
  CREATED
  COURIER_ASSIGNED
  COURIER_ACCEPTED
  COURIER_DECLINED
  PICKUP_STARTED
  PICKED_UP
  IN_TRANSIT
  ARRIVED_AT_HOSPITAL
  DELIVERED
  FAILED
  CANCELLED
}

enum CourierStatus {
  AVAILABLE
  BUSY
  OFFLINE
  SUSPENDED
}

enum ShipmentEventType {
  CREATED
  COURIER_ASSIGNED
  COURIER_ACCEPTED
  COURIER_DECLINED
  PICKUP_STARTED
  PICKED_UP
  IN_TRANSIT
  LOCATION_UPDATED
  ARRIVED_AT_HOSPITAL
  DELIVERED
  FAILED
  CANCELLED
}

enum DeliveryFailureReason {
  VEHICLE_ISSUE
  ROAD_ISSUE
  COURIER_ISSUE
  HOSPITAL_UNAVAILABLE
  PACKAGE_ISSUE
  OTHER
}

enum EmergencyStatus {
  DRAFT
  ACTIVE
  MATCHING
  RESPONSES_RECEIVED
  DONOR_CONFIRMED
  DONOR_EN_ROUTE
  DONOR_ARRIVED
  DONATION_STARTED
  COMPLETED
  CANCELLED
  EXPIRED
  FAILED
}

enum EmergencyMatchStatus {
  MATCHED
  NOTIFIED
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
  NO_RESPONSE
}

enum EmergencyResponseStatus {
  ACCEPTED
  EN_ROUTE
  ARRIVED
  DONATION_STARTED
  COMPLETED
  CANCELLED
  FAILED
}

enum LocationType {
  STORAGE
  QUARANTINE
  PROCESSING
  DISTRIBUTION
}

enum DonationEventType {
  CREATED
  CHECKED_IN
  ASSESSMENT_RECORDED
  STARTED
  COMPLETED
  CANCELLED
  ABORTED
  REJECTED
  VERIFIED
}

model User {
  id            String    @id @default(cuid())
  email         String   @unique @db.VarChar(254)
  phone         String?  @unique @db.VarChar(20)
  passwordHash  String
  firstName     String   @db.VarChar(80)
  lastName      String   @db.VarChar(80)
  displayName   String?  @db.VarChar(120)
  avatarUrl     String?  @db.VarChar(500)
  dateOfBirth   DateTime? @db.Date
  status        UserStatus @default(PENDING_VERIFICATION)
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastLoginAt   DateTime?

  memberships            OrganizationMembership[]
  donorProfile          DonorProfile?
  notificationPreference NotificationPreference?
  refreshTokens         RefreshToken[]
  auditLogs             AuditLog[]
  emailVerification     EmailVerificationToken?
  sessions              Session[]
  appointments          Appointment[]
  appointmentHistory    AppointmentHistory[]
  donations             Donation[]
  donationEvents        DonationEvent[]
  donationAssessments   DonationAssessment[]
  verifiedBloodUnits    BloodUnit[]         @relation("BloodUnitVerifier")
  inventoryMovements    InventoryMovement[]
  reservations          BloodUnitReservation[]
  courier               Courier?
  bloodRequestEvents    BloodRequestEvent[]
  shipmentEvents        ShipmentEvent[]
  emergencyRequests     EmergencyRequest[] @relation("EmergencyCreator")
  emergencyMatches     EmergencyMatch[]   @relation("EmergencyDonor")
  emergencyResponses    EmergencyResponse[] @relation("EmergencyResponseDonor")
  laboratoryResults     LaboratoryResult[] @relation("LaboratoryResultDonor")
  gamificationProfile   GamificationProfile?
  communityPosts        CommunityPost[]    @relation("CommunityPostAuthor")
  campaignParticipations CampaignParticipant[]
  challengeParticipations ChallengeParticipant[]
  educationProgress     EducationProgress[]
  contentReports        ContentReport[]    @relation("ContentReportReporter")
  reviewedReports       ContentReport[]    @relation("ContentReportReviewer")
  createdChallenges     Challenge[]        @relation("ChallengeCreator")

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([phone])
}

model Role {
  id   String   @id @default(cuid())
  code RoleCode @unique
  name String

  memberships OrganizationMembership[]
  permissions RolePermission[]
}

model Permission {
  id    String @id @default(cuid())
  code  String @unique
  name  String
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Organization {
  id        String             @id @default(cuid())
  type      OrganizationType
  name      String
  legalName String?
  phone     String?
  email     String?
  address   String?
  latitude  Decimal?           @db.Decimal(9, 6)
  longitude Decimal?           @db.Decimal(9, 6)
  status    OrganizationStatus @default(PENDING_APPROVAL)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  memberships   OrganizationMembership[]
  auditLogs     AuditLog[]
  hospital      Hospital?
  bloodCenter   BloodCenter?
  appointmentSlots AppointmentSlot[]
  appointments  Appointment[]
  donations     Donation[]
  donationEvents DonationEvent[]
  bloodUnits    BloodUnit[]
  locations     InventoryLocation[]
  movements     InventoryMovement[]
  reservations  BloodUnitReservation[]
  reservedFor  BloodUnitReservation[]  @relation("ReservationForOrganization")
  alerts        InventoryAlert[]
  bloodRequestsRequested BloodRequest[] @relation("RequestingOrganization")
  bloodRequestsFulfilled BloodRequest[] @relation("FulfillingOrganization")
  shipmentsSource Shipment[] @relation("ShipmentSource")
  shipmentsDestination Shipment[] @relation("ShipmentDestination")
  couriers     Courier[]
  bloodRequestEvents BloodRequestEvent[]
  shipmentEvents   ShipmentEvent[]
  emergencyRequests EmergencyRequest[]
  laboratoryProfile  LaboratoryProfile?
  laboratoryResults LaboratoryResult[] @relation("LaboratoryResultOrganization")
  testReferenceRanges TestReferenceRange[]
  communityPosts    CommunityPost[]
  campaigns         Campaign[]
  challenges        Challenge[]

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Hospital {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model BloodCenter {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  roleId         String
  status         MembershipStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([userId, organizationId, roleId])
  @@index([userId])
  @@index([organizationId])
  @@index([roleId])
  @@index([status])
}

model DonorProfile {
  id                   String             @id @default(cuid())
  userId               String             @unique
  bloodType            BloodType?
  rhFactor             RhFactor?
  bloodTypeVerifiedAt   DateTime?
  bloodTypeVerifiedBy   String?
  bloodTypeSource       VerificationSource?
  bloodTypeNote        String?
  city                 String?            @db.VarChar(100)
  district             String?            @db.VarChar(100)
  donorStatus          DonorStatus        @default(ACTIVE)
  verificationStatus   VerificationStatus @default(UNVERIFIED)
  dateOfBirth          DateTime?          @db.Date
  consentLocation      Boolean            @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bloodType])
  @@index([donorStatus])
}

model NotificationPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  emergencyRequests  Boolean  @default(true)
  appointments       Boolean  @default(true)
  donationReminders  Boolean  @default(true)
  healthResults      Boolean  @default(false)
  gamification       Boolean  @default(true)
  bloodRequests      Boolean  @default(true)
  shipments          Boolean  @default(true)
  inventory          Boolean  @default(true)
  system             Boolean  @default(true)
  security           Boolean  @default(true)
  quietHoursEnabled  Boolean  @default(false)
  quietHoursStart    String?
  quietHoursEnd      String?
  quietHoursTimezone String   @default("UTC")
  emergencyOverride  Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenHash])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  deviceName   String?
  deviceType   String?
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([revokedAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  token     String   @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
}

model AuditLog {
  id             String    @id @default(cuid())
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  organizationId String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime  @default(now())

  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([organizationId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model AppointmentSlot {
  id               String         @id @default(cuid())
  organizationId   String
  appointmentType  AppointmentType
  startAt          DateTime
  endAt            DateTime
  capacity         Int            @default(1)
  bookedCount     Int            @default(0)
  status           SlotStatus     @default(AVAILABLE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments   Appointment[]

  @@index([organizationId])
  @@index([appointmentType])
  @@index([startAt])
  @@index([endAt])
  @@index([status])
  @@index([organizationId, appointmentType, startAt])
}

model Appointment {
  id                  String            @id @default(cuid())
  referenceNumber      String            @unique
  donorId             String
  organizationId      String
  slotId              String
  appointmentType     AppointmentType
  status              AppointmentStatus @default(PENDING)
  scheduledStart      DateTime
  scheduledEnd        DateTime
  notes               String?
  cancellationReason  String?
  cancelledAt         DateTime?
  completedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  donor              User              @relation(fields: [donorId], references: [id], onDelete: Cascade)
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slot               AppointmentSlot   @relation(fields: [slotId], references: [id], onDelete: Cascade)
  history            AppointmentHistory[]
  donation          Donation?
  laboratoryResult   LaboratoryResult?

  @@index([donorId])
  @@index([organizationId])
  @@index([slotId])
  @@index([status])
  @@index([scheduledStart])
  @@index([scheduledEnd])
  @@index([referenceNumber])
  @@index([donorId, status])
}

model AppointmentHistory {
  id             String            @id @default(cuid())
  appointmentId  String
  action         String
  previousStatus AppointmentStatus?
  newStatus      AppointmentStatus?
  actorId        String?
  reason         String?
  metadata       Json?
  createdAt     DateTime          @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  actor       User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([appointmentId])
  @@index([actorId])
  @@index([createdAt])
}

model Donation {
  id                 String            @id @default(cuid())
  donationReference  String            @unique
  donorId           String
  organizationId     String
  appointmentId      String?           @unique
  donationType       DonationType      @default(WHOLE_BLOOD)
  status             DonationStatus    @default(SCHEDULED)
  bloodType          BloodType?
  rhFactor           RhFactor?
  volumeMl           Int?
  collectionStartedAt DateTime?
  collectionCompletedAt DateTime?
  staffNotes         String?
  nextDonationDate   DateTime?
  cancellationReason CancellationReason?
  cancelledAt        DateTime?
  abortedAt          DateTime?
  abortedReason      String?
  rejectedAt         DateTime?
  rejectedReason     String?
  completedAt        DateTime?
  completedBy        String?
  verifiedAt         DateTime?
  verifiedBy        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  donor         User                @relation(fields: [donorId], references: [id], onDelete: Cascade)
  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment   Appointment?         @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  events        DonationEvent[]
  assessment    DonationAssessment?
  bloodUnit     BloodUnit?

  @@index([donorId])
  @@index([organizationId])
  @@index([appointmentId])
  @@index([status])
  @@index([createdAt])
  @@index([donationReference])
  @@index([collectionCompletedAt])
  @@index([bloodType])
}

model DonationEvent {
  id             String           @id @default(cuid())
  donationId     String
  eventType      DonationEventType
  actorId        String?
  organizationId String?
  metadata       Json?
  createdAt     DateTime         @default(now())

  donation     Donation     @relation(fields: [donationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([donationId])
  @@index([actorId])
  @@index([eventType])
  @@index([createdAt])
}

model DonationAssessment {
  id           String            @id @default(cuid())
  donationId   String            @unique
  decision     AssessmentDecision
  reasonCategory String?
  notes        String?
  assessedBy   String?
  assessedAt   DateTime         @default(now())

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  assessor  User?    @relation(fields: [assessedBy], references: [id], onDelete: SetNull)

  @@index([donationId])
  @@index([assessedBy])
}

model BloodUnit {
  id             String         @id @default(cuid())
  unitReference  String         @unique
  donationId     String         @unique
  organizationId String
  componentType  ComponentType  @default(WHOLE_BLOOD)
  bloodType      BloodType
  rhFactor       RhFactor
  volumeMl       Int
  status         BloodUnitStatus @default(COLLECTED)
  locationId     String?
  collectedAt    DateTime
  expiresAt      DateTime?
  verifiedAt     DateTime?
  verifiedBy     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  donation       Donation              @relation(fields: [donationId], references: [id], onDelete: Cascade)
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location      InventoryLocation?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  verifier      User?                @relation("BloodUnitVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)
  movements     InventoryMovement[]
  reservations  BloodUnitReservation[]
  shipmentUnits ShipmentUnit[]

  @@index([donationId])
  @@index([organizationId])
  @@index([bloodType])
  @@index([status])
  @@index([collectedAt])
  @@index([locationId])
  @@index([unitReference])
}

model InventoryLocation {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  code           String
  type           LocationType @default(STORAGE)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bloodUnits   BloodUnit[]
  movementsFrom InventoryMovement[] @relation("FromLocation")
  movementsTo   InventoryMovement[] @relation("ToLocation")

  @@index([organizationId])
  @@index([active])
}

model InventoryMovement {
  id             String       @id @default(cuid())
  bloodUnitId    String
  organizationId String
  fromLocationId String?
  toLocationId   String?
  type           MovementType
  actorId        String?
  reason         String?
  createdAt      DateTime     @default(now())

  bloodUnit     BloodUnit         @relation(fields: [bloodUnitId], references: [id], onDelete: Cascade)
  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromLocation  InventoryLocation? @relation("FromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation    InventoryLocation? @relation("ToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  actor         User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([bloodUnitId])
  @@index([organizationId])
  @@index([type])
  @@index([createdAt])
}

model BloodUnitReservation {
  id                       String            @id @default(cuid())
  bloodUnitId               String
  organizationId            String
  reservedForOrganizationId String?
  status                   ReservationStatus @default(ACTIVE)
  reservedBy                String
  reservedAt                DateTime          @default(now())
  expiresAt                DateTime?
  releasedAt               DateTime?
  fulfilledAt              DateTime?
  reason                   String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  bloodUnit                BloodUnit     @relation(fields: [bloodUnitId], references: [id], onDelete: Cascade)
  organization             Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservedForOrganization   Organization? @relation("ReservationForOrganization", fields: [reservedForOrganizationId], references: [id], onDelete: SetNull)
  reservedByUser           User         @relation(fields: [reservedBy], references: [id], onDelete: Cascade)
  bloodRequestItems        BloodRequestItem[]
  shipmentUnits            ShipmentUnit[]

  @@index([bloodUnitId])
  @@index([organizationId])
  @@index([status])
  @@index([reservedAt])
}

model InventoryAlert {
  id             String      @id @default(cuid())
  organizationId String
  type           AlertType
  bloodType      BloodType?
  rhFactor       RhFactor?
  message        String
  threshold      Int?
  currentValue   Int?
  acknowledged   Boolean     @default(false)
  acknowledgedAt DateTime?
  acknowledgedBy String?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([type])
  @@index([acknowledged])
}

model BloodRequest {
  id                       String             @id @default(cuid())
  requestReference         String             @unique
  requestingOrganizationId String
  fulfillingOrganizationId  String?
  priority                  BloodRequestPriority @default(ROUTINE)
  status                    BloodRequestStatus  @default(DRAFT)
  notes                     String?
  deliveryAddress           String?
  deliveryLatitude          Decimal?           @db.Decimal(9, 6)
  deliveryLongitude         Decimal?           @db.Decimal(9, 6)
  deliveryPhone             String?
  expectedDeliveryDate      DateTime?
  deliveredAt               DateTime?
  cancelledAt               DateTime?
  cancellationReason        String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  requestingOrganization  Organization          @relation("RequestingOrganization", fields: [requestingOrganizationId], references: [id], onDelete: Cascade)
  fulfillingOrganization  Organization?         @relation("FulfillingOrganization", fields: [fulfillingOrganizationId], references: [id], onDelete: SetNull)
  items                  BloodRequestItem[]
  events                 BloodRequestEvent[]
  shipment               Shipment?

  @@index([requestingOrganizationId])
  @@index([fulfillingOrganizationId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model BloodRequestItem {
  id              String   @id @default(cuid())
  bloodRequestId  String
  bloodType       BloodType
  rhFactor        RhFactor
  componentType   ComponentType @default(WHOLE_BLOOD)
  unitsRequested  Int
  unitsApproved   Int      @default(0)
  unitsFulfilled  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bloodRequest   BloodRequest @relation(fields: [bloodRequestId], references: [id], onDelete: Cascade)
  reservations    BloodUnitReservation[]
  shipmentUnits   ShipmentUnit[]

  @@index([bloodRequestId])
  @@index([bloodType])
  @@index([rhFactor])
}

model BloodRequestEvent {
  id              String            @id @default(cuid())
  bloodRequestId  String
  eventType       String
  actorId         String?
  organizationId  String?
  metadata        Json?
  createdAt       DateTime          @default(now())

  bloodRequest  BloodRequest @relation(fields: [bloodRequestId], references: [id], onDelete: Cascade)
  actor         User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  organization  Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([bloodRequestId])
  @@index([actorId])
  @@index([createdAt])
}

model Courier {
  id                 String        @id @default(cuid())
  userId             String        @unique
  organizationId     String
  displayName        String
  phone              String?
  status             CourierStatus @default(OFFLINE)
  currentShipmentId  String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shipments         Shipment[]
  locations         ShipmentLocation[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
}

model Shipment {
  id                        String        @id @default(cuid())
  shipmentReference         String        @unique
  bloodRequestId            String        @unique
  sourceOrganizationId      String
  destinationOrganizationId  String
  courierId                 String?
  status                    ShipmentStatus @default(CREATED)
  pickupAddress             String?
  pickupLatitude            Decimal?      @db.Decimal(9, 6)
  pickupLongitude           Decimal?      @db.Decimal(9, 6)
  destinationAddress        String?
  destinationLatitude       Decimal?      @db.Decimal(9, 6)
  destinationLongitude      Decimal?      @db.Decimal(9, 6)
  assignedAt                DateTime?
  acceptedAt                DateTime?
  declinedAt                DateTime?
  declineReason             String?
  pickupStartedAt           DateTime?
  pickedUpAt                DateTime?
  inTransitAt               DateTime?
  arrivedAt                 DateTime?
  deliveredAt               DateTime?
  failedAt                  DateTime?
  failureReason             DeliveryFailureReason?
  failureNotes              String?
  cancelledAt               DateTime?
  cancellationReason        String?
  estimatedArrivalAt        DateTime?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  bloodRequest             BloodRequest   @relation(fields: [bloodRequestId], references: [id], onDelete: Cascade)
  sourceOrganization       Organization   @relation("ShipmentSource", fields: [sourceOrganizationId], references: [id], onDelete: Cascade)
  destinationOrganization  Organization   @relation("ShipmentDestination", fields: [destinationOrganizationId], references: [id], onDelete: Cascade)
  courier                  Courier?       @relation(fields: [courierId], references: [id], onDelete: SetNull)
  units                    ShipmentUnit[]
  events                   ShipmentEvent[]
  locations                ShipmentLocation[]

  @@index([bloodRequestId])
  @@index([sourceOrganizationId])
  @@index([destinationOrganizationId])
  @@index([courierId])
  @@index([status])
  @@index([shipmentReference])
  @@index([createdAt])
}

model ShipmentUnit {
  id              String        @id @default(cuid())
  shipmentId      String
  bloodUnitId    String
  reservationId   String
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  status          String        @default("PENDING")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  shipment        Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  bloodUnit       BloodUnit     @relation(fields: [bloodUnitId], references: [id], onDelete: Cascade)
  reservation     BloodUnitReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  bloodRequestItem BloodRequestItem? @relation(fields: [bloodRequestItemId], references: [id], onDelete: SetNull)
  bloodRequestItemId String?

  @@unique([shipmentId, bloodUnitId])
  @@index([shipmentId])
  @@index([bloodUnitId])
  @@index([reservationId])
}

model ShipmentEvent {
  id              String          @id @default(cuid())
  shipmentId      String
  eventType       ShipmentEventType
  actorId         String?
  organizationId  String?
  metadata        Json?
  createdAt       DateTime        @default(now())

  shipment       Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  actor          User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([actorId])
  @@index([createdAt])
}

model ShipmentLocation {
  id           String   @id @default(cuid())
  shipmentId   String
  courierId    String
  latitude     Decimal  @db.Decimal(9, 6)
  longitude    Decimal  @db.Decimal(9, 6)
  accuracy     Decimal? @db.Decimal(8, 2)
  heading      Decimal? @db.Decimal(5, 2)
  speed        Decimal? @db.Decimal(6, 2)
  recordedAt   DateTime @default(now())

  shipment     Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  courier      Courier  @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([courierId])
  @@index([recordedAt])
}

model EmergencyRequest {
  id                   String          @id @default(cuid())
  emergencyReference   String         @unique
  hospitalId           String
  bloodType           BloodType
  rhFactor            RhFactor
  unitsRequired       Int
  urgencyLevel         String         @default("CRITICAL")
  status              EmergencyStatus @default(DRAFT)
  patientReference    String?
  description         String?
  requiredBefore      DateTime?
  donationLocation    String?
  latitude            Decimal?        @db.Decimal(9, 6)
  longitude           Decimal?        @db.Decimal(9, 6)
  unitsCommitted     Int             @default(0)
  unitsArrived        Int             @default(0)
  unitsCollected      Int             @default(0)
  createdBy           String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  closedAt           DateTime?
  cancelledAt        DateTime?

  hospital           Organization        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  creator           User               @relation("EmergencyCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  matches           EmergencyMatch[]
  responses         EmergencyResponse[]

  @@index([hospitalId])
  @@index([bloodType])
  @@index([rhFactor])
  @@index([status])
  @@index([urgencyLevel])
  @@index([createdAt])
}

model EmergencyMatch {
  id                   String               @id @default(cuid())
  emergencyRequestId   String
  donorId             String
  matchScore          Float?
  distanceKm          Float?
  status              EmergencyMatchStatus @default(MATCHED)
  notifiedAt          DateTime?
  viewedAt            DateTime?
  respondedAt          DateTime?
  expiredAt           DateTime?
  createdAt          DateTime        @default(now())

  emergencyRequest    EmergencyRequest @relation(fields: [emergencyRequestId], references: [id], onDelete: Cascade)
  donor              User             @relation("EmergencyDonor", fields: [donorId], references: [id], onDelete: Cascade)
  response          EmergencyResponse?

  @@unique([emergencyRequestId, donorId])
  @@index([emergencyRequestId])
  @@index([donorId])
  @@index([status])
  @@index([createdAt])
}

model EmergencyResponse {
  id                   String                   @id @default(cuid())
  emergencyRequestId   String
  matchId             String?              @unique
  donorId             String
  status              EmergencyResponseStatus @default(ACCEPTED)
  acceptedAt          DateTime?
  enRouteAt           DateTime?
  arrivedAt           DateTime?
  donationStartedAt    DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  emergencyRequest    EmergencyRequest @relation(fields: [emergencyRequestId], references: [id], onDelete: Cascade)
  donor              User             @relation("EmergencyResponseDonor", fields: [donorId], references: [id], onDelete: Cascade)
  match              EmergencyMatch?  @relation(fields: [matchId], references: [id], onDelete: SetNull)
  locations         EmergencyLocation[]

  @@index([emergencyRequestId])
  @@index([donorId])
  @@index([status])
  @@index([createdAt])
}

model EmergencyLocation {
  id                   String   @id @default(cuid())
  emergencyResponseId  String
  latitude             Decimal  @db.Decimal(9, 6)
  longitude            Decimal  @db.Decimal(9, 6)
  accuracy             Decimal? @db.Decimal(8, 2)
  heading              Decimal? @db.Decimal(5, 2)
  speed                Decimal? @db.Decimal(6, 2)
  recordedAt          DateTime @default(now())

  emergencyResponse    EmergencyResponse @relation(fields: [emergencyResponseId], references: [id], onDelete: Cascade)

  @@index([emergencyResponseId])
  @@index([recordedAt])
}

model TestType {
  id            String       @id @default(cuid())
  code          String       @unique
  name          String
  description   String?
  category      TestCategory @default(GENERAL)
  isActive      Boolean      @default(true)
  displayOrder  Int         @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  parameters         TestParameter[]
  referenceRanges    TestReferenceRange[]
  laboratoryProfiles LaboratoryProfile[]
  laboratoryResults  LaboratoryResult[]

  @@index([category])
  @@index([isActive])
}

model TestParameter {
  id                String   @id @default(cuid())
  testTypeId       String
  code             String
  name             String
  description       String?
  unit              String?
  dataType          String   @default("numeric")
  required          Boolean  @default(true)
  displayOrder      Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  testType           TestType               @relation(fields: [testTypeId], references: [id], onDelete: Cascade)
  resultItems        LaboratoryResultItem[]

  @@unique([testTypeId, code])
  @@index([testTypeId])
}

model TestReferenceRange {
  id             String    @id @default(cuid())
  testTypeId     String
  laboratoryId   String?
  minValue       Decimal?  @db.Decimal(10, 3)
  maxValue       Decimal?  @db.Decimal(10, 3)
  unit           String?
  notes          String?
  effectiveFrom  DateTime?
  effectiveTo   DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  testType     TestType      @relation(fields: [testTypeId], references: [id], onDelete: Cascade)
  laboratory   Organization? @relation(fields: [laboratoryId], references: [id], onDelete: SetNull)

  @@index([testTypeId])
  @@index([laboratoryId])
  @@index([isActive])
}

model LaboratoryProfile {
  id             String   @id @default(cuid())
  organizationId String   @unique
  name           String
  address        String?
  phone          String?
  email          String?
  workingHours   String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  testTypes      TestType[]

  @@index([organizationId])
}

model LaboratoryResult {
  id              String            @id @default(cuid())
  appointmentId   String           @unique
  donorId         String
  laboratoryId    String
  testTypeId      String
  status          String           @default("PENDING")
  performedAt     DateTime?
  performedBy     String?
  reviewedAt      DateTime?
  reviewedBy      String?
  publishedAt     DateTime?
  publishedBy     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  appointment     Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  donor           User             @relation("LaboratoryResultDonor", fields: [donorId], references: [id], onDelete: Cascade)
  laboratory      Organization     @relation("LaboratoryResultOrganization", fields: [laboratoryId], references: [id], onDelete: Cascade)
  testType        TestType         @relation(fields: [testTypeId], references: [id], onDelete: Cascade)
  items           LaboratoryResultItem[]
  versions        LaboratoryResultVersion[]

  @@index([donorId])
  @@index([laboratoryId])
  @@index([testTypeId])
  @@index([status])
  @@index([appointmentId])
  @@index([publishedAt])
}

model LaboratoryResultItem {
  id              String    @id @default(cuid())
  resultId        String
  parameterId     String
  value           String?
  numericValue    Decimal?  @db.Decimal(15, 4)
  unit            String?
  referenceMin    Decimal?  @db.Decimal(10, 3)
  referenceMax    Decimal?  @db.Decimal(10, 3)
  flag            ResultFlag @default(NOT_AVAILABLE)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  result          LaboratoryResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  parameter       TestParameter    @relation(fields: [parameterId], references: [id], onDelete: Cascade)

  @@index([resultId])
  @@index([parameterId])
}

model LaboratoryResultVersion {
  id              String    @id @default(cuid())
  resultId        String
  version         Int
  status          String
  changeReason    String?
  changedBy       String?
  createdAt       DateTime  @default(now())

  result          LaboratoryResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@unique([resultId, version])
  @@index([resultId])
}

enum AchievementType {
  DONATION_COUNT
  EMERGENCY_RESPONSE_COUNT
