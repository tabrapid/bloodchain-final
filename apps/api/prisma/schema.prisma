  APPOINTMENT_COMPLETION_COUNT
  XP_MILESTONE
  STREAK
  CUSTOM_EVENT
  CHALLENGE_COMPLETED
  CAMPAIGN_PARTICIPATED
  EDUCATION_COMPLETED
}

enum AchievementRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum AchievementStatus {
  LOCKED
  IN_PROGRESS
  UNLOCKED
}

enum XpTransactionType {
  DONATION_COMPLETED
  EMERGENCY_DONATION_COMPLETED
  BLOOD_TEST_COMPLETED
  APPOINTMENT_COMPLETED
  PROFILE_COMPLETED
  ACHIEVEMENT_UNLOCKED
  ADMIN_ADJUSTMENT
  EMERGENCY_RESPONSE_ACCEPTED
  STREAK_BONUS
  CHALLENGE_COMPLETED
  CAMPAIGN_PARTICIPATED
  EDUCATION_COMPLETED
}

enum ReputationType {
  VERIFIED_CONTRIBUTION
  EMERGENCY_RESPONSE
  APPOINTMENT_ATTENDANCE
  COMMUNITY_ACTION
  ADMIN_ADJUSTMENT
}

model GamificationProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  totalXp               Int       @default(0)
  level                 Int       @default(1)
  reputationScore       Int       @default(0)
  leaderboardVisibility Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  xpTransactions      XpTransaction[]
  achievements        AchievementUnlock[]
  reputationTx        ReputationTransaction[]

  @@index([userId])
  @@index([totalXp])
  @@index([level])
}

model XpTransaction {
  id          String          @id @default(cuid())
  userId      String
  amount      Int
  type        XpTransactionType
  sourceType  String?
  sourceId    String?
  description String?
  metadata    Json?
  createdAt   DateTime        @default(now())

  profile GamificationProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Achievement {
  id              String           @id @default(cuid())
  code            String           @unique
  type            AchievementType
  name            String
  description     String
  icon            String
  rarity          AchievementRarity @default(COMMON)
  criteria        Json
  xpReward        Int              @default(0)
  displayOrder    Int              @default(0)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  unlocks         AchievementUnlock[]
  badges          Badge[]
  posts           CommunityPost[]

  @@index([type])
  @@index([isActive])
  @@index([displayOrder])
}

model AchievementUnlock {
  id             String           @id @default(cuid())
  userId         String
  achievementId  String
  unlockedAt     DateTime         @default(now())
  progress       Int              @default(0)
  target         Int              @default(1)

  profile     GamificationProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement         @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

model Badge {
  id             String           @id @default(cuid())
  code           String           @unique
  name           String
  description    String
  icon           String
  rarity         AchievementRarity @default(COMMON)
  achievementId  String?
  displayOrder   Int              @default(0)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  achievement    Achievement?      @relation(fields: [achievementId], references: [id], onDelete: SetNull)
  userBadges     UserBadge[]
  challenges     Challenge[]

  @@index([isActive])
  @@index([displayOrder])
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())

  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

model ReputationTransaction {
  id          String         @id @default(cuid())
  userId      String
  amount      Int
  type        ReputationType
  sourceType  String?
  sourceId    String?
  reason      String?
  metadata    Json?
  createdAt   DateTime      @default(now())

  profile GamificationProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ============================================================================
// COMMUNITY & GAMIFICATION EXPANSION (Phase 18)
