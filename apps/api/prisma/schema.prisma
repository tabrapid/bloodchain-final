enum CommunityPostType {
  CAMPAIGN
  EDUCATION
  MILESTONE
  ACHIEVEMENT
  COMMUNITY_UPDATE
  ANNOUNCEMENT
  IMPACT
}

enum CommunityPostStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  REMOVED
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ChallengeType {
  DONATION_MILESTONE
  CAMPAIGN_PARTICIPATION
  EDUCATION
  COMMUNITY
  APPOINTMENT_COMPLETION
  CONSISTENCY
}

enum ChallengeStatus {
  DRAFT
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum ChallengeVisibility {
  PUBLIC
  ORGANIZATION
  PRIVATE
}

enum ContentReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTIONED
}

enum ContentReportReason {
  SPAM
  HARASSMENT
  MISINFORMATION
  INAPPROPRIATE
  OTHER
}

enum EducationContentType {
  ARTICLE
  QUIZ
  VIDEO
}

enum EducationProgressStatus {
  STARTED
  COMPLETED
}

model CommunityPost {
  id              String              @id @default(cuid())
  type            CommunityPostType
  title           String
  body            String
  imageUrl        String?
  authorId        String?
  organizationId  String?
  campaignId      String?
  achievementId   String?
  status          CommunityPostStatus @default(PUBLISHED)
  metadata        Json?
  publishedAt     DateTime            @default(now())
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  author          User?               @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  organization    Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  campaign        Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  achievement     Achievement?        @relation(fields: [achievementId], references: [id], onDelete: SetNull)
  reports         ContentReport[]

  @@index([type])
  @@index([status])
  @@index([publishedAt])
  @@index([organizationId])
  @@index([campaignId])
}

model Campaign {
  id                String          @id @default(cuid())
  organizationId    String
  title             String
  description       String
  imageUrl          String?
  startDate         DateTime
  endDate           DateTime
  location          String?
  latitude          Decimal?        @db.Decimal(9, 6)
  longitude         Decimal?        @db.Decimal(9, 6)
  bloodGroupsNeeded BloodType[]
  targetParticipants Int?
  status            CampaignStatus  @default(DRAFT)
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  participants      CampaignParticipant[]
  posts             CommunityPost[]

  @@index([organizationId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model CampaignParticipant {
  id          String   @id @default(cuid())
  campaignId  String
  userId      String
  status      String   @default("JOINED")
  joinedAt    DateTime @default(now())
  completedAt DateTime?

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
}

model Challenge {
  id              String             @id @default(cuid())
  title           String
  description     String
  type            ChallengeType
  status          ChallengeStatus    @default(DRAFT)
  visibility      ChallengeVisibility @default(PUBLIC)
  organizationId  String?
  startDate       DateTime?
  endDate         DateTime?
  goal            Int                @default(1)
  xpReward        Int                @default(0)
  badgeId         String?
  metadata        Json?
  createdBy       String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization    Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  badge           Badge?             @relation(fields: [badgeId], references: [id], onDelete: SetNull)
  creator         User?              @relation("ChallengeCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  participants    ChallengeParticipant[]

  @@index([type])
  @@index([status])
  @@index([visibility])
  @@index([organizationId])
  @@index([startDate])
  @@index([endDate])
}

model ChallengeParticipant {
  id            String   @id @default(cuid())
  challengeId   String
  userId        String
  progress      Int      @default(0)
  completedAt   DateTime?
  joinedAt      DateTime @default(now())
  updatedAt     DateTime @updatedAt

  challenge     Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([challengeId])
  @@index([userId])
  @@index([completedAt])
}

model EducationalContent {
  id            String              @id @default(cuid())
  type          EducationContentType
  title         String
  description   String
  body          String
  imageUrl      String?
  category      String
  difficulty    String              @default("BEGINNER")
  xpReward      Int                 @default(0)
  estimatedMinutes Int?
  isActive      Boolean             @default(true)
  displayOrder  Int                 @default(0)
  metadata      Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  progress      EducationProgress[]

  @@index([type])
  @@index([category])
  @@index([isActive])
  @@index([displayOrder])
}

model EducationProgress {
  id          String                  @id @default(cuid())
  userId      String
  contentId   String
  status      EducationProgressStatus @default(STARTED)
  startedAt   DateTime                @default(now())
  completedAt DateTime?
  xpAwarded   Int                     @default(0)

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     EducationalContent      @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId])
  @@index([userId])
  @@index([contentId])
  @@index([status])
}

model ContentReport {
  id          String              @id @default(cuid())
  postId      String
  reporterId  String
  reason      ContentReportReason
  description String?
  status      ContentReportStatus @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  resolution  String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  post        CommunityPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter    User                @relation("ContentReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer    User?               @relation("ContentReportReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([reporterId])
  @@index([status])
  @@index([createdAt])
}

enum NotificationType {
  EMERGENCY
  DONATION
  APPOINTMENT
  LABORATORY
  AI
  GAMIFICATION
  BLOOD_REQUEST
  SHIPMENT
  INVENTORY
  SECURITY
  SYSTEM
  COMMUNITY
  CAMPAIGN
  CHALLENGE
  EDUCATION
}

enum NotificationPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  ARCHIVED
  EXPIRED
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  INVALID_TOKEN
}

model PushDevice {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  platform    String
  deviceId    String?
  appVersion  String?
  locale      String   @default("en")
  timezone    String?
  isActive    Boolean  @default(true)
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([isActive])
  @@index([lastSeenAt])
}

model Notification {
  id           String              @id @default(cuid())
  recipientId  String
  type         NotificationType
  priority     NotificationPriority @default(NORMAL)
  title        String
  body         String
  data         Json?
  deepLink     String?
  status       NotificationStatus @default(PENDING)
  readAt       DateTime?
  expiresAt    DateTime?
  sourceType   String?
  sourceId     String?
  idempotencyKey String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  deliveries   NotificationDelivery[]

  @@index([recipientId])
  @@index([type])
  @@index([priority])
  @@index([status])
  @@index([createdAt])
  @@index([idempotencyKey])
  @@unique([recipientId, idempotencyKey])
}

model NotificationDelivery {
  id               String         @id @default(cuid())
  notificationId  String
  channel          String
  status           DeliveryStatus @default(PENDING)
  providerId       String?
  attempts         Int            @default(0)
  lastAttemptAt    DateTime?
  deliveredAt      DateTime?
  failedAt         DateTime?
  errorCode        String?
  errorMessage     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([status])
}
