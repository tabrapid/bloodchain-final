/**
 * A single-use, expiring credential for regaining access to an account.
 * Stores a SHA-256 hash of the token, never the token itself. A password-reset
 * token is account takeover in one string: anyone who can read the table --
 * a backup, a support query, a log of a row dump -- could use it. Hashing means
 * the stored value is worthless on its own, and lookup by hash costs nothing
 * because the client always presents the original.
 * One row per user, replaced on each request, so a new request invalidates the
 * previous link and tokens do not accumulate.
 */
model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String    @unique
  tokenHash   String    @unique @db.VarChar(64)
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?   @db.VarChar(64)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([expiresAt])
}

