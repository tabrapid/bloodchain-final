{
  "expo": {
    "name": "Bloodchain",
    "slug": "bloodchain",
    "scheme": "donor",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "uz.bloodchain.donor",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "uz.bloodchain.donor",
      "buildNumber": "1"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bloodchain uses your location while you use the app to show which donation centres are nearest to you and, if you choose, to save a home area so nearby emergency requests can reach you. When you accept an emergency request or carry a delivery, your location is shared with the authorised hospital staff handling it, for that journey only.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
