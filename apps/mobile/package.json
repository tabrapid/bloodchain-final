{
  "name": "@bloodchain/mobile",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "^22.18.0 || ^24.3.0 || >= 25.0.0"
  },
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "//": "SDK 57's template wants typescript ~6.0.3. This monorepo shares one TypeScript across eleven packages, so that move is a monorepo-wide change with its own risk surface and is not a mobile sprint's to make (docs/mobile-release-readiness.md section 12). Declared here so expo-doctor reports a deliberate deviation as one, rather than reporting a failing check nobody is going to act on.",
      "exclude": [
        "typescript"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "prebuild": "expo prebuild --clean",
    "run:android": "expo run:android",
    "run:ios": "expo run:ios",
    "export": "expo export",
    "doctor": "expo-doctor",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" app.config.ts",
    "test": "jest"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "@bloodchain/i18n": "workspace:*",
    "@bloodchain/types": "workspace:*",
    "@bloodchain/utils": "workspace:*",
    "@bloodchain/validation": "workspace:*",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/manrope": "0.4.2",
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.62.8",
    "expo": "~57.0.25",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-font": "^57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linear-gradient": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^0.511.0",
    "react": "19.2.3",
    "react-hook-form": "^7.54.2",
    "react-native": "0.86.3",
    "react-native-chart-kit": "^7.0.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native/jest-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.0",
    "@types/react-test-renderer": "^19.0.0",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "^1.20.4",
    "expo-linking": "~57.0.11",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-dom": "19.2.3",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.7.2"
  }
}
